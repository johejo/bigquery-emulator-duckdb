package(default_visibility = ["//visibility:public"])

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

alias(
    name = "runtime",
    actual = select({
        ":macos_arm64": "@python_static_macos_arm64//:runtime",
        ":linux_arm64": "@python_static_linux_arm64//:runtime",
        ":linux_amd64": "@python_static_linux_amd64//:runtime",
    }),
)

alias(
    name = "python3",
    actual = select({
        ":macos_arm64": "@python_static_macos_arm64//:python3",
        ":linux_arm64": "@python_static_linux_arm64//:python3",
        ":linux_amd64": "@python_static_linux_amd64//:python3",
    }),
)

alias(
    name = "files",
    actual = select({
        ":macos_arm64": "@python_static_macos_arm64//:files",
        ":linux_arm64": "@python_static_linux_arm64//:files",
        ":linux_amd64": "@python_static_linux_amd64//:files",
    }),
)

exports_files([
    "BUILD.python.bazel",
    "native_archive.bzl",
])
