load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# DuckDB v2 folds vendored dependencies into the core and extension archives. The core and
# extensions reference each other, so keep them whole. Register only the extensions used here;
# the shell and the remaining release extensions are not linked.
_WHOLE = [
    "libautocomplete_extension.a",
    "libcore_functions_extension.a",
    "libduckdb_static.a",
    "libicu_extension.a",
    "libjson_extension.a",
    "libparquet_extension.a",
]

[
    cc_import(
        name = lib.removesuffix(".a"),
        static_library = lib,
        visibility = ["//visibility:private"],
        alwayslink = True,
    )
    for lib in _WHOLE
]

cc_library(
    name = "duckdb",
    hdrs = [
        "duckdb.h",
        "duckdb_static_extension.h",
    ],
    linkopts = select({
        "@platforms//os:linux": [
            "-lpthread",
            "-ldl",
        ],
        "//conditions:default": [],
    }),
    deps = [":" + lib.removesuffix(".a") for lib in _WHOLE],
)
