load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# DuckDB's official static libraries: the core, the extensions the release loads statically
# (core_functions, icu, json, parquet, autocomplete) and the vendored third-party libraries, whose
# symbols DuckDB keeps in its own namespaces. The unused tpch and tpcds extensions are left out.
#
# The core, the generated extension loader and the extensions reference each other in a cycle,
# which GNU ld cannot resolve in one pass over the archives, so they are linked whole.
cc_library(
    name = "duckdb",
    srcs = [
        "libautocomplete_extension.a",
        "libcore_functions_extension.a",
        "libduckdb_generated_extension_loader.a",
        "libduckdb_static.a",
        "libicu_extension.a",
        "libjson_extension.a",
        "libparquet_extension.a",
    ],
    hdrs = ["duckdb.h"],
    alwayslink = True,
    deps = [":vendored"],
)

cc_library(
    name = "vendored",
    srcs = glob(
        ["libduckdb_*.a"],
        exclude = [
            "libduckdb_generated_extension_loader.a",
            "libduckdb_static.a",
        ],
    ),
    linkopts = select({
        "@platforms//os:linux": [
            "-lpthread",
            "-ldl",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:private"],
)
