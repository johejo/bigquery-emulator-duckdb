load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# The core, the generated extension loader and the extensions the release loads statically
# (core_functions, icu, json, parquet, autocomplete) reference each other in a cycle, which GNU ld
# cannot resolve in one pass over the archives, so they are linked whole. The unused tpch and tpcds
# extensions are left out.
_WHOLE = [
    "libautocomplete_extension.a",
    "libcore_functions_extension.a",
    "libduckdb_generated_extension_loader.a",
    "libduckdb_static.a",
    "libicu_extension.a",
    "libjson_extension.a",
    "libparquet_extension.a",
]

# The vendored third-party libraries, whose symbols DuckDB keeps in its own namespaces.
_VENDORED = glob(
    ["libduckdb_*.a"],
    exclude = _WHOLE,
)

[
    cc_import(
        name = lib.removesuffix(".a"),
        alwayslink = True,
        static_library = lib,
        visibility = ["//visibility:private"],
    )
    for lib in _WHOLE
]

[
    cc_import(
        name = lib.removesuffix(".a"),
        static_library = lib,
        visibility = ["//visibility:private"],
    )
    for lib in _VENDORED
]

cc_library(
    name = "duckdb",
    hdrs = ["duckdb.h"],
    linkopts = select({
        "@platforms//os:linux": [
            "-lpthread",
            "-ldl",
        ],
        "//conditions:default": [],
    }),
    deps = [":" + lib.removesuffix(".a") for lib in _WHOLE + _VENDORED],
)
