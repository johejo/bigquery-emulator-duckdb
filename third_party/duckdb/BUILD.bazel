exports_files(["BUILD.duckdb.bazel"])

config_setting(
    name = "macos_aarch64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

# The prebuilt static libduckdb for the target platform.
alias(
    name = "duckdb",
    actual = select(
        {
            ":macos_aarch64": "@duckdb_prebuilt_macos_arm64//:duckdb",
            ":linux_x86_64": "@duckdb_prebuilt_linux_amd64//:duckdb",
            ":linux_aarch64": "@duckdb_prebuilt_linux_arm64//:duckdb",
        },
        no_match_error = "No prebuilt libduckdb for this platform; supported are macOS on aarch64 and Linux on x86_64 and aarch64.",
    ),
    visibility = ["//visibility:public"],
)
