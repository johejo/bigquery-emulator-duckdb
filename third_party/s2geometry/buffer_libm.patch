+// S1ChordAngle(angle), with correctly rounded sin.
+static S1ChordAngle CorrectlyRoundedChordAngle(S1Angle angle) {
+  double length = 2 * cr_sin(0.5 * min(M_PI, angle.radians()));
+  return S1ChordAngle::FromLength2(length * length);
+}
