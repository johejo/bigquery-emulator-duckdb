load("@rules_cc//cc:cc_library.bzl", "cc_library")

# cpp-httplib with TLS enabled through BoringSSL, so the emulator can download gs:// objects from
# the public Storage API. The define is exported to every dependent: httplib.h changes its class
# layouts with it, so all translation units must agree on it.
cc_library(
    name = "httplib",
    defines = ["CPPHTTPLIB_OPENSSL_SUPPORT"],
    # On macOS, httplib loads root certificates from the Keychain.
    linkopts = select({
        "@platforms//os:macos": [
            "-framework",
            "CoreFoundation",
            "-framework",
            "Security",
            "-framework",
            "CFNetwork",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = ["@cpp-httplib//:httplib"],
)
