load("@rules_cc//cc:cc_library.bzl", "cc_library")

# cpp-httplib with TLS enabled through BoringSSL, so the emulator can download gs:// objects from
# the public Storage API. The defines are exported to every dependent: httplib.h changes its class
# layouts with them, so all translation units must agree on them.
cc_library(
    name = "httplib",
    defines = [
        "CPPHTTPLIB_OPENSSL_SUPPORT",
        # Read root certificates from BoringSSL's default paths, such as /etc/ssl/cert.pem, on
        # macOS as on Linux, rather than from the Keychain through the Apple frameworks.
        "CPPHTTPLIB_DISABLE_MACOSX_AUTOMATIC_ROOT_CERTIFICATES",
    ],
    visibility = ["//visibility:public"],
    deps = ["@cpp-httplib//:httplib"],
)
