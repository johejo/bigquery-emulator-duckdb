+
+JSValue JS_CallWithThrowLocation(JSContext *ctx, JSValueConst func_obj,
+                                 JSValueConst this_obj, int argc, JSValueConst *argv,
+                                 int *line, int *column)
+{
+    JSRuntime *rt = ctx->rt;
+    struct JSThrowLocation location = { JS_ATOM_NULL, 0, 0 };
+    if (JS_IsObject(func_obj)) {
+        JSObject *p = JS_VALUE_GET_OBJ(func_obj);
+        if (js_class_has_bytecode(p->class_id))
+            location.filename = p->u.func.function_bytecode->filename;
+    }
+    struct JSThrowLocation *previous = rt->throw_location;
+    rt->throw_location = &location;
+    JSValue result = JS_Call(ctx, func_obj, this_obj, argc, argv);
+    rt->throw_location = previous;
+    *line = JS_IsException(result) ? location.line : 0;
+    *column = JS_IsException(result) ? location.column : 0;
+    return result;
 }
 
