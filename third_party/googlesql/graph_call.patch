+  absl::Status VisitResolvedGraphCallScan(
+      const ResolvedGraphCallScan* scan) override {
+    // A GQL CALL is lateral, but the inliner's argument CTEs cannot capture
+    // columns. Preserve the direct TVF scan for the emulator to lower instead.
+    if (!scan->subquery()->Is<ResolvedTVFScan>()) {
+      return CopyVisitResolvedGraphCallScan(scan);
+    }
+    const auto* previous = std::exchange(graph_call_tvf_, scan->subquery());
+    const auto status = CopyVisitResolvedGraphCallScan(scan);
+    graph_call_tvf_ = previous;
+    return status;
+  }
