diff --git a/clang_tidy/clang_tidy.bzl b/clang_tidy/clang_tidy.bzl
index 6df71db..78e1874 100644
--- a/clang_tidy/clang_tidy.bzl
+++ b/clang_tidy/clang_tidy.bzl
@@ -186,8 +186,19 @@ def builtin_include_flags(cc_toolchain):
     Returns:
         list[str]: Compiler flags for the builtin include directories.
     """
-    flags = []
+    # libc++ refuses to work when a C standard library include directory is searched
+    # before its own headers, and toolchains do not necessarily report the directories
+    # in that order (Apple's does not). Keep the C++ ones in front.
+    cxx_dirs = []
+    other_dirs = []
     for built_in_include_dir in cc_toolchain.built_in_include_directories:
+        if "/c++/" in built_in_include_dir or built_in_include_dir.endswith("/c++"):
+            cxx_dirs.append(built_in_include_dir)
+        else:
+            other_dirs.append(built_in_include_dir)
+
+    flags = []
+    for built_in_include_dir in cxx_dirs + other_dirs:
         flags.extend(["-isystem", built_in_include_dir])
     return flags
 
