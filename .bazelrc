common --enable_platform_specific_config

# GoogleSQL requires C++20 for dependencies and build tools as well.
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20

# Use the development shell tools for target and exec actions, including on NixOS.
build --action_env=PATH
build --host_action_env=PATH

# GoogleSQL loads time zones at runtime. Forward TZDIR, when set, to actions and tests for hosts
# without /usr/share/zoneinfo, such as NixOS.
build --action_env=TZDIR
build --test_env=TZDIR

# Enable warnings for this repository's sources, including build tools, and fail on them, without
# changing dependency compilation flags. Apple clang leaves designated initializers that omit a
# field out of -Wextra, while the Nix clang on Linux warns about them.
build --per_file_copt=^(src|tests|tools)/.*@-Wall,-Wextra,-Wpedantic,-Wshadow,-Wmissing-designated-field-initializers,-Werror
build --host_per_file_copt=^(src|tests|tools)/.*@-Wall,-Wextra,-Wpedantic,-Wshadow,-Wmissing-designated-field-initializers,-Werror

# Silence warnings from dependencies, which this repository cannot fix, while keeping warnings
# from its own C++ sources. -w covers dependency sources. Dependency headers are found through
# -iquote, so warnings inside them, such as deprecations in inline functions, would still be
# reported while compiling this repository's sources; treat them as system headers (a clang flag;
# the Nix and Xcode toolchains are clang). Direct uses of deprecated APIs are still reported.
build --per_file_copt=external/.*@-w
build --host_per_file_copt=external/.*@-w
build --copt=--system-header-prefix=absl/
build --copt=--system-header-prefix=google/
build --copt=--system-header-prefix=googlesql/
build --copt=--system-header-prefix=s2/
build --host_copt=--system-header-prefix=absl/
build --host_copt=--system-header-prefix=google/
build --host_copt=--system-header-prefix=googlesql/
build --host_copt=--system-header-prefix=s2/

# Optimize dependencies, such as GoogleSQL, while this repository's sources keep the fastbuild
# defaults so that they recompile quickly. The emulator starts in about half the CPU time, which
# speeds up the probes and end-to-end tests that start many emulators. Exec tools are already
# optimized.
build --per_file_copt=external/.*@-O2

# Build libpq against the BoringSSL that gRPC already links, rather than a second TLS library
# whose symbols would collide with it.
common --@postgres//:with_ssl=boringssl

# GoogleSQL's py_binary relies on implicit __init__.py creation, which rules_python deprecates. No
# Python target in the build needs it.
build --incompatible_default_to_explicit_init_py
# Bootstrap directly into rules_python's interpreter without a host Python on PATH.
build --@rules_python//python/config_settings:bootstrap_impl=script

# macOS build compatibility.
build:macos --features=-header_modules
build:macos --features=-parse_headers
# Apple's linker warns about the -lm and -lpthread that protobuf adds to each of its targets; Bazel
# does not deduplicate link options across targets.
build:macos --linkopt=-Wl,-no_warn_duplicate_libraries
build:macos --host_linkopt=-Wl,-no_warn_duplicate_libraries

# clang-tidy uses the build's C++ toolchain and target parsing settings; see tools/clang_tidy/.
build:clang-tidy --aspects=//tools/clang_tidy:clang_tidy.bzl%clang_tidy
build:clang-tidy --output_groups=clang_tidy
# Report every file's findings in one run instead of stopping at the first failure.
build:clang-tidy --keep_going

# CI settings. GitHub Actions saves and restores these caches between runs; see
# .github/workflows/test.yml.
build:ci --disk_cache=~/.cache/bazel-disk
build:ci --repository_cache=~/.cache/bazel-repo
# Reuse extracted repositories across runs instead of fetching them again. The cache outlives
# dependency changes, so let Bazel remove unused entries while its server waits between steps.
build:ci --repo_contents_cache=~/.cache/bazel-repo/contents
build:ci --repo_contents_cache_gc_idle_delay=5s
# Let Gazelle reuse the Go caches that CI saves between runs.
build:ci --repo_env=GO_REPOSITORY_USE_HOST_CACHE=1
# Keep the disk cache within the repository's cache quota; a full macOS run uses about 6G.
build:ci --experimental_disk_cache_gc_max_size=7G
build:ci --experimental_disk_cache_gc_max_age=3d
build:ci --experimental_disk_cache_gc_idle_delay=5s
test:ci --test_output=errors

# The release recipe uses a separate output base and toolchain. glibc remains dynamic.
build:release --compilation_mode=opt
build:release --dynamic_mode=off
build:release --linkopt=-static-libstdc++
build:release --linkopt=-static-libgcc
build:release --symlink_prefix=.cache/release/bazel-

# Optional machine-specific settings (not checked into Git).
try-import %workspace%/.bazelrc.local
