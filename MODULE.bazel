# Gazelle must use a recent host Go too: gRPC's transitive Envoy module otherwise selects
# Go 1.24, which cannot fetch GoogleSQL's textmapper (requires Go 1.25 or newer).
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(
    name = "storage_host_go",
    go_mod = "//:go.mod",
)

# GoogleSQL's code generators use a pip hub that has wheels only for Python 3.11, while
# rules_python 2.4 defaults to Python 3.14.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

# Google's differential privacy library, at the version GoogleSQL's reference implementation uses.
googlesql_http_archive_deps = use_extension(
    "@googlesql//bazel:http_archive_deps.bzl",
    "googlesql_http_archive_deps",
)
use_repo(
    googlesql_http_archive_deps,
    "com_google_cc_differential_privacy",
    "com_google_differential_privacy",
)

clang_tidy_repository = use_repo_rule("//tools/clang_tidy:repository.bzl", "clang_tidy_repository")

clang_tidy_repository(
    name = "clang_tidy_tool",
    dev_dependency = True,
)

# Fetch the pinned source without a Git executable on Bazel's PATH.
archive_override(
    module_name = "hedron_compile_commands",
    integrity = "sha256-0vpNvkSknhubrxJ/FSLCGe3nhFwjselx3zfOZ1OG8v0=",
    strip_prefix = "bazel-compile-commands-extractor-078ba7675c05bea2666c92d9a8abe200d8547655",
    urls = ["https://github.com/helly25/bazel-compile-commands-extractor/archive/078ba7675c05bea2666c92d9a8abe200d8547655.tar.gz"],
)

# Correctly rounded math functions for converting between degrees and S2Point, and for S2's
# buffering, whose patched s2geometry depends on it; see third_party/core_math.
archive_override(
    module_name = "core_math",
    build_file = "//third_party/core_math:BUILD.core_math.bazel",
    integrity = "sha256-UsrYRF+HKsXxaamASlpcfOl8EVnG1dIDExxoWGJp3HY=",
    patch_cmds = [
        "printf 'module(name = \"core_math\")\\nbazel_dep(name = \"rules_cc\", version = \"0.2.22\")\\n' > MODULE.bazel",
    ],
    strip_prefix = "core-math-e3f1fcc7daf46c61332357fac591e19e88902926",
    urls = ["https://gitlab.inria.fr/core-math/core-math/-/archive/e3f1fcc7daf46c61332357fac591e19e88902926/core-math-e3f1fcc7daf46c61332357fac591e19e88902926.tar.gz"],
)

archive_override(
    module_name = "googlesql",
    integrity = "sha256-ogEX6e38nRP7xt54xmqCowwZOyXodu/R7GnbD/Jzah0=",
    patch_strip = 1,
    patches = [
        # Lets //:compliance_test use GoogleSQL's compliance test cases.
        "//third_party/googlesql:compliance.patch",
        "//third_party/googlesql:compliance_expected_results.patch",
        "//third_party/googlesql:openssl.patch",
    ],
    strip_prefix = "googlesql-2026.11.3",
    urls = ["https://github.com/google/googlesql/archive/refs/tags/2026.11.3.tar.gz"],
)

# The embedded CPython's SSL and hash modules are compiled against OpenSSL 3.5 headers but link
# this OpenSSL, so keep its ABI although curl requires OpenSSL 4; //:python_openssl_test checks it.
single_version_override(
    module_name = "openssl",
    version = "3.5.5.bcr.4",
)

# OpenSSL's public headers belong to its crypto target, even for SSL clients. Protobuf 37 moves
# the C++ upb reflection headers that gRPC uses to //upb/reflection:reflection_cc, as GoogleSQL's
# own override of gRPC adds.
single_version_override(
    module_name = "grpc",
    patch_cmds = [
        "sed -i.bak 's|\"@com_google_protobuf//upb/reflection\"|\"@com_google_protobuf//upb/reflection\", \"@com_google_protobuf//upb/reflection:reflection_cc\"|g' BUILD src/core/BUILD test/core/xds/BUILD && rm -f BUILD.bak src/core/BUILD.bak test/core/xds/BUILD.bak",
    ],
    patch_strip = 1,
    patches = ["//third_party/grpc:openssl.patch"],
)

# Use one crypto implementation with the embedded Python runtime.
single_version_override(
    module_name = "google_cloud_cpp",
    patch_strip = 1,
    patches = ["//third_party/google_cloud_cpp:openssl.patch"],
)

# Both PostgreSQL and QuickJS export incompatible unicode_normalize functions.
single_version_override(
    module_name = "quickjs-ng",
    patch_strip = 1,
    patches = ["//third_party/quickjs:unicode_symbol.patch"],
)

single_version_override(
    module_name = "linenoise",
    patch_strip = 1,
    # Keeps the shell's line editing on standard input and error; see the patch's README.
    patches = ["//third_party/linenoise:terminal_fds.patch"],
)

single_version_override(
    module_name = "geographiclib",
    patch_strip = 1,
    patches = ["//third_party/geographiclib:hypot.patch"],
)

single_version_override(
    module_name = "s2geometry",
    patch_strip = 1,
    # Abseil 20260526 removes an internal API s2geometry uses, as it does for GoogleSQL.
    patches = [
        "//third_party/s2geometry:throw_delegate.patch",
        "//third_party/s2geometry:covering_order.patch",
        "//third_party/s2geometry:buffer_libm.patch",
    ],
)

