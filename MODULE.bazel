http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Prebuilt static libduckdb per platform, linked into the binary; //third_party/duckdb selects the
# one for the target platform, so only that archive is downloaded.
#
# DuckDB's ICU extension embeds ICU 66 and GoogleSQL links ICU 76. ICU versions nearly all of its
# symbols, but the UCaseMap constructors and destructors sit outside the versioned namespace and
# the two versions' layouts differ, so DuckDB's copies are made local to its archive.
#
# The checks around the localization fail the fetch when a new release no longer matches these
# assumptions: the symbols must be defined in libicu_extension.a, no object may reference them
# from outside (such a reference would silently bind to GoogleSQL's ICU 76 copy once DuckDB's is
# local), and afterwards no archive may still export them.
#
# The tools are named explicitly so that no other nm or objcopy on PATH is picked up: Apple's own
# on macOS, where nmedit exists only in cctools, and the devshell's LLVM on Linux.
_UCASEMAP_ERROR = "echo 'DuckDB static-libs: %s; revisit the UCaseMap localization in MODULE.bazel' >&2; exit 1"

_UCASEMAP_BEFORE = "; ".join([
    "set -euo pipefail",
    "defined=$(\"$NM\" -g --defined-only libicu_extension.a | awk '/ZN8UCaseMap/ {print $3}')",
    "if [ -z \"$defined\" ]; then " + _UCASEMAP_ERROR % "libicu_extension.a defines no UCaseMap symbols" + "; fi",
    "undefined=$(\"$NM\" -u lib*.a)",
    "if grep -q ZN8UCaseMap <<<\"$undefined\"; then " + _UCASEMAP_ERROR % "an object references UCaseMap from outside its definition" + "; fi",
]) + "; "

_UCASEMAP_AFTER = "; " + "; ".join([
    "exported=$(\"$NM\" -g --defined-only lib*.a)",
    "if grep -q ZN8UCaseMap <<<\"$exported\"; then " + _UCASEMAP_ERROR % "UCaseMap symbols are still exported" + "; fi",
])

_LOCALIZE_UCASEMAP_MACOS = "NM=/usr/bin/nm; " + _UCASEMAP_BEFORE + "printf '%s\\n' \"$defined\" > ucasemap.syms && /usr/bin/nmedit -R ucasemap.syms libicu_extension.a && rm ucasemap.syms" + _UCASEMAP_AFTER

_LOCALIZE_UCASEMAP_LINUX = "NM=llvm-nm; " + _UCASEMAP_BEFORE + "llvm-objcopy --wildcard --localize-symbol='_ZN8UCaseMap*' libicu_extension.a" + _UCASEMAP_AFTER

http_archive(
    name = "duckdb_prebuilt_macos_arm64",
    build_file = "//third_party/duckdb:BUILD.duckdb.bazel",
    patch_cmds = [_LOCALIZE_UCASEMAP_MACOS],
    sha256 = "e77c382fba15e3f5c0b3265d12e3a4de534699fdb91bcc9d10d4a857a58103d5",
    urls = [
        "https://install.duckdb.org/v1.5.6/static-libs-osx-arm64.zip",
        "https://github.com/duckdb/duckdb/releases/download/v1.5.6/static-libs-osx-arm64.zip",
    ],
)

