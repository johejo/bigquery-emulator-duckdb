# Keep headers, standard library and native modules from the same archive as libpython.
http_archive(
    name = "python_static_macos_arm64",
    build_file = "//third_party/python:BUILD.python.bazel",
    sha256 = "7fb24a63a038bc56625555b5f9a35c4ad5e1eba5a7118208f603ed7400571e8e",
    strip_prefix = "python",
    urls = ["https://github.com/astral-sh/python-build-standalone/releases/download/20260414/cpython-3.11.15%2B20260414-aarch64-apple-darwin-pgo%2Blto-full.tar.zst"],
)

http_archive(
    name = "python_static_linux_arm64",
    build_file = "//third_party/python:BUILD.python.bazel",
    sha256 = "fcd25215254607ae4e2bf1501cb0f69a3c6166f9aff319259962cad445fb0288",
    strip_prefix = "python",
    urls = ["https://github.com/astral-sh/python-build-standalone/releases/download/20260414/cpython-3.11.15%2B20260414-aarch64-unknown-linux-gnu-pgo%2Blto-full.tar.zst"],
)

http_archive(
    name = "python_static_linux_amd64",
    build_file = "//third_party/python:BUILD.python.bazel",
    sha256 = "01e607cf764b97d4d5d6f69fd1ff3d8a9a162513dde5c39e98260fce40fe220a",
