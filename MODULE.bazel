module(
    name = "bigquery_emulator_duckdb",
    version = "0.0.0",
)

bazel_dep(name = "cpp-httplib", version = "0.46.0")
bazel_dep(name = "googlesql", version = "2026.9.2")
bazel_dep(name = "googletest", version = "1.17.0", repo_name = "com_google_googletest")

bazel_dep(name = "bazel_clang_tidy", dev_dependency = True)
bazel_dep(name = "bazel_skylib", version = "1.6.1", dev_dependency = True)
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)

bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.19")

git_override(
    module_name = "bazel_clang_tidy",
    commit = "c4d35e0d0b838309358e57a2efed831780f85cd0",
    patch_strip = 1,
    patches = ["//third_party/bazel_clang_tidy:cxx_include_order.patch"],
    remote = "https://github.com/erenon/bazel_clang_tidy.git",
)

git_override(
    module_name = "hedron_compile_commands",
    commit = "abb61a688167623088f8768cc9264798df6a9d10",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
)

archive_override(
    module_name = "googlesql",
    integrity = "sha256-Bi6Z2jQDKs31HB2VR5ds72HKT4PaQqSHYDqi4/JJJX4=",
    strip_prefix = "googlesql-2026.9.2",
    urls = ["https://github.com/google/googlesql/archive/refs/tags/2026.9.2.tar.gz"],
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Prebuilt libduckdb per platform; //third_party/duckdb selects the one for the target platform,
# so only that archive is downloaded.
http_archive(
    name = "duckdb_prebuilt_macos_universal",
    build_file = "//third_party/duckdb:BUILD.duckdb_macos.bazel",
    sha256 = "7b5b8915cc382d0708636fe6385c0cdad5a61c9ff8ba2638b3e2141640783155",
    urls = ["https://github.com/duckdb/duckdb/releases/download/v1.5.5/libduckdb-osx-universal.zip"],
)

http_archive(
    name = "duckdb_prebuilt_linux_amd64",
    build_file = "//third_party/duckdb:BUILD.duckdb_linux.bazel",
    sha256 = "1fb8ce388157d84a25abe685a8a2520bf00c00321821968e4bb398fd766e7abb",
    urls = ["https://github.com/duckdb/duckdb/releases/download/v1.5.5/libduckdb-linux-amd64.zip"],
)

http_archive(
    name = "duckdb_prebuilt_linux_arm64",
    build_file = "//third_party/duckdb:BUILD.duckdb_linux.bazel",
    sha256 = "abe4f6f005ee0b448a058322f4263584b4bd1b6faf7ab4637b79eeaf978f8e9c",
    urls = ["https://github.com/duckdb/duckdb/releases/download/v1.5.5/libduckdb-linux-arm64.zip"],
)
