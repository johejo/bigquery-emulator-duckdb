# Gazelle must use a recent host Go too: gRPC's transitive Envoy module otherwise selects
# Go 1.24, which cannot fetch GoogleSQL's textmapper (requires Go 1.25 or newer).
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(
    name = "storage_host_go",
    go_mod = "//:go.mod",
)

clang_tidy_repository = use_repo_rule("//tools/clang_tidy:repository.bzl", "clang_tidy_repository")

clang_tidy_repository(
    name = "clang_tidy_tool",
    dev_dependency = True,
)

