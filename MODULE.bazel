    build_file = "//third_party/duckdb:BUILD.duckdb.bazel",
    patch_cmds = [_LOCALIZE_UCASEMAP_LINUX],
    sha256 = "56249751117a4c04289764e06eb431352ce33fb3f8e2f30401122d4d0e184139",
