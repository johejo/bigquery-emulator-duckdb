module(
    name = "bigquery_emulator_duckdb",
    version = "0.0.0",
)

bazel_dep(name = "abseil-cpp", version = "20260526.0")
bazel_dep(name = "openssl", version = "3.5.5.bcr.4")
bazel_dep(name = "cpp-httplib", version = "0.46.0")
bazel_dep(name = "curl", version = "8.12.0.bcr.1")
bazel_dep(name = "google_cloud_cpp", version = "3.10.0")
bazel_dep(name = "googleapis", version = "0.0.0-20260825-d10ac924")
bazel_dep(name = "grpc", version = "1.84.0")
bazel_dep(name = "googlesql", version = "2026.10.1")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", repo_name = "com_google_googletest")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

bazel_dep(name = "hedron_compile_commands", dev_dependency = True)

bazel_dep(name = "linenoise", version = "2.0.0.bcr.1")
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "postgres", version = "18.4")
bazel_dep(name = "protobuf", version = "35.1")
bazel_dep(name = "quickjs-ng", version = "0.15.1.bcr.1")
bazel_dep(name = "re2", version = "2025-08-12.bcr.1")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "rules_python", version = "2.3.2")
bazel_dep(name = "s2geometry", version = "0.14.0")
bazel_dep(name = "zlib", version = "1.3.2")

# Gazelle must use a recent host Go too: gRPC's transitive Envoy module otherwise selects
# Go 1.24, which cannot fetch GoogleSQL's textmapper (requires Go 1.25 or newer).
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(
    name = "storage_host_go",
    go_mod = "//:go.mod",
)

clang_tidy_repository = use_repo_rule("//tools/clang_tidy:repository.bzl", "clang_tidy_repository")

clang_tidy_repository(
    name = "clang_tidy_tool",
    dev_dependency = True,
)

# Fetch the pinned source without a Git executable on Bazel's PATH.
archive_override(
    module_name = "hedron_compile_commands",
    integrity = "sha256-0vpNvkSknhubrxJ/FSLCGe3nhFwjselx3zfOZ1OG8v0=",
    strip_prefix = "bazel-compile-commands-extractor-078ba7675c05bea2666c92d9a8abe200d8547655",
    urls = ["https://github.com/helly25/bazel-compile-commands-extractor/archive/078ba7675c05bea2666c92d9a8abe200d8547655.tar.gz"],
)

archive_override(
    module_name = "googlesql",
    integrity = "sha256-YwDmVmu+e4X2te2GqOV2nGvgu6nbq0acJVX4ekIxtro=",
    patch_strip = 1,
    # Abseil 20260526 (required by google_cloud_cpp 3.9+) removes an internal API GoogleSQL uses.
    patches = [
        "//third_party/googlesql:throw_delegate.patch",
        # Lets //:compliance_test use GoogleSQL's compliance test cases.
        "//third_party/googlesql:compliance.patch",
        "//third_party/googlesql:compliance_expected_results.patch",
        "//third_party/googlesql:openssl.patch",
    ],
    strip_prefix = "googlesql-2026.10.1",
    urls = ["https://github.com/google/googlesql/archive/refs/tags/2026.10.1.tar.gz"],
)

single_version_override(
    module_name = "cpp-httplib",
    patch_strip = 1,
    patches = ["//third_party/cpp_httplib:openssl.patch"],
)

# OpenSSL's public headers belong to its crypto target, even for SSL clients.
single_version_override(
    module_name = "grpc",
    patch_strip = 1,
    patches = ["//third_party/grpc:openssl.patch"],
)

# Use one crypto implementation with the embedded Python runtime.
single_version_override(
    module_name = "google_cloud_cpp",
    patch_strip = 1,
    patches = ["//third_party/google_cloud_cpp:openssl.patch"],
)

# Both PostgreSQL and QuickJS export incompatible unicode_normalize functions.
single_version_override(
    module_name = "quickjs-ng",
    patch_strip = 1,
    patches = ["//third_party/quickjs:unicode_symbol.patch"],
)

single_version_override(
    module_name = "linenoise",
    patch_strip = 1,
    # Keeps the shell's line editing on standard input and error; see the patch's README.
    patches = ["//third_party/linenoise:terminal_fds.patch"],
)

single_version_override(
    module_name = "s2geometry",
    patch_strip = 1,
    # Abseil 20260526 removes an internal API s2geometry uses, as it does for GoogleSQL.
    patches = [
        "//third_party/s2geometry:throw_delegate.patch",
        "//third_party/s2geometry:covering_order.patch",
    ],
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

