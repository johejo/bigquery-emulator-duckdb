    name = "duckdb_prebuilt_linux_amd64",
    build_file = "//third_party/duckdb:BUILD.duckdb.bazel",
    patch_cmds = [_LOCALIZE_UCASEMAP_LINUX],
    sha256 = "ab3d1d33951b8cb8bdcae740d8e06adf66bfb7ee880a3f7052d7a35088e16d2d",
    urls = [
        "https://install.duckdb.org/v1.5.6/static-libs-linux-amd64.zip",
        "https://github.com/duckdb/duckdb/releases/download/v1.5.6/static-libs-linux-amd64.zip",
    ],
)

