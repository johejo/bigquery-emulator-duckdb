module(
    name = "bigquery_emulator_duckdb",
    version = "0.0.0",
)

bazel_dep(name = "cpp-httplib", version = "0.46.0")
bazel_dep(name = "google_cloud_cpp", version = "3.10.0")
bazel_dep(name = "googlesql", version = "2026.9.2")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", repo_name = "com_google_googletest")

bazel_dep(name = "bazel_clang_tidy", dev_dependency = True)
bazel_dep(name = "bazel_skylib", version = "1.9.2", dev_dependency = True)
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)

bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.19")

git_override(
    module_name = "bazel_clang_tidy",
    commit = "c4d35e0d0b838309358e57a2efed831780f85cd0",
    patch_strip = 1,
    patches = ["//third_party/bazel_clang_tidy:cxx_include_order.patch"],
    remote = "https://github.com/erenon/bazel_clang_tidy.git",
)

git_override(
    module_name = "hedron_compile_commands",
    commit = "078ba7675c05bea2666c92d9a8abe200d8547655",
    remote = "https://github.com/helly25/bazel-compile-commands-extractor.git",
)

archive_override(
    module_name = "googlesql",
    integrity = "sha256-Bi6Z2jQDKs31HB2VR5ds72HKT4PaQqSHYDqi4/JJJX4=",
    patch_strip = 1,
    # Abseil 20260526 (required by google_cloud_cpp 3.9+) removes an internal API GoogleSQL uses.
    patches = ["//third_party/googlesql:throw_delegate.patch"],
    strip_prefix = "googlesql-2026.9.2",
    urls = ["https://github.com/google/googlesql/archive/refs/tags/2026.9.2.tar.gz"],
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Prebuilt static libduckdb per platform, linked into the binary; //third_party/duckdb selects the
# one for the target platform, so only that archive is downloaded.
#
# DuckDB's ICU extension embeds ICU 66 and GoogleSQL links ICU 76. ICU versions nearly all of its
# symbols, but the UCaseMap constructors and destructors sit outside the versioned namespace and
# the two versions' layouts differ, so DuckDB's copies are made local to its archive.
http_archive(
    name = "duckdb_prebuilt_macos_arm64",
    build_file = "//third_party/duckdb:BUILD.duckdb.bazel",
    patch_cmds = [
        "nm -gU libicu_extension.a | awk '/__ZN8UCaseMap/ {print $3}' > ucasemap.syms",
        "nmedit -R ucasemap.syms libicu_extension.a",
        "rm ucasemap.syms",
    ],
    sha256 = "d79ec66b8a4054b866faada82e9e31f859a713c555b3f1c4b71c4a43d3273e9c",
    urls = ["https://github.com/duckdb/duckdb/releases/download/v1.5.5/static-libs-osx-arm64.zip"],
)

http_archive(
    name = "duckdb_prebuilt_linux_amd64",
    build_file = "//third_party/duckdb:BUILD.duckdb.bazel",
    patch_cmds = ["objcopy --wildcard --localize-symbol='_ZN8UCaseMap*' libicu_extension.a"],
    sha256 = "deb47c5300f3c99725e84cdb14d214c3b12bbd748b613b1698b938c894cb68eb",
    urls = ["https://github.com/duckdb/duckdb/releases/download/v1.5.5/static-libs-linux-amd64.zip"],
)

http_archive(
    name = "duckdb_prebuilt_linux_arm64",
    build_file = "//third_party/duckdb:BUILD.duckdb.bazel",
    patch_cmds = ["objcopy --wildcard --localize-symbol='_ZN8UCaseMap*' libicu_extension.a"],
    sha256 = "ea6a34cb49ec2db5ed23d9e8311237c53c32abf9cdbf5dd608c4176c3dd8bfeb",
    urls = ["https://github.com/duckdb/duckdb/releases/download/v1.5.5/static-libs-linux-arm64.zip"],
)
