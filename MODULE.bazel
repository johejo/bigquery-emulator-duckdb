    module_name = "googlesql",
    integrity = "sha256-YwDmVmu+e4X2te2GqOV2nGvgu6nbq0acJVX4ekIxtro=",
    patch_strip = 1,
    # Abseil 20260526 (required by google_cloud_cpp 3.9+) removes an internal API GoogleSQL uses.
    patches = [
        "//third_party/googlesql:throw_delegate.patch",
        # Lets //:compliance_test use GoogleSQL's compliance test cases.
        "//third_party/googlesql:compliance.patch",
    ],
    strip_prefix = "googlesql-2026.10.1",
    urls = ["https://github.com/google/googlesql/archive/refs/tags/2026.10.1.tar.gz"],
)

