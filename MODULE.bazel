http_archive(
    name = "nanoarrow",
    build_file = "//third_party/nanoarrow:BUILD.nanoarrow.bazel",
    patch_args = ["-p1"],
    patches = ["//third_party/nanoarrow:public_headers.patch"],
    sha256 = "bb422ce7ed486abd95eb027a1ac092bbc1b5ed44955e89c098f0a1cb75109d5c",
    strip_prefix = "arrow-nanoarrow-apache-arrow-nanoarrow-0.7.0",
    urls = ["https://github.com/apache/arrow-nanoarrow/archive/refs/tags/apache-arrow-nanoarrow-0.7.0.tar.gz"],
