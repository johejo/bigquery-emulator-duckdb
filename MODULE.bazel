module(
    name = "bigquery_emulator_duckdb",
    version = "0.0.0",
)

bazel_dep(name = "cpp-httplib", version = "0.46.0")
bazel_dep(name = "googlesql", version = "2026.9.2")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", repo_name = "com_google_googletest")

bazel_dep(name = "bazel_clang_tidy", dev_dependency = True)
bazel_dep(name = "bazel_skylib", version = "1.8.2", dev_dependency = True)
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)

bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.19")
bazel_dep(name = "toolchains_llvm", version = "1.10.0")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    # Match the installed SDK's TAPI format; LLVM 21's ld64.lld cannot read macOS 27 stubs.
    linker = {
        "darwin-aarch64": "auto",
        "darwin-x86_64": "auto",
    },
    llvm_version = "23.1.2",
    # LLVM 23 is the first release whose Linux lld links libxml2 statically, so it runs on
    # hosts without libxml2.so.2. toolchains_llvm picks the .tar.zst archives, but since 23.1.2
    # (llvm/llvm-project#219587) they use a 1 GiB window (--long=30), and Bazel's zstd decoder
    # only accepts up to 128 MiB; use the .tar.xz archives from the same release instead.
    sha256 = {
        "darwin-aarch64": "d7c26fc6177e42842e2d1ffaad31aec057c56a924392b1a23d830abe2c5d53b1",
        "linux-aarch64": "075da47cb832273717d4c7bad4b6b4848d7c154262e9ba0dcc0025426d4073f0",
        "linux-x86_64": "b5ed9675149cc837c282e9b6962c276c9fa62863d5b2f91537b60848552995b7",
    },
    strip_prefix = {
        "darwin-aarch64": "LLVM-23.1.2-macOS-ARM64",
        "linux-aarch64": "LLVM-23.1.2-Linux-ARM64",
        "linux-x86_64": "LLVM-23.1.2-Linux-X64",
    },
    urls = {
        "darwin-aarch64": ["https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.2/LLVM-23.1.2-macOS-ARM64.tar.xz"],
        "linux-aarch64": ["https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.2/LLVM-23.1.2-Linux-ARM64.tar.xz"],
        "linux-x86_64": ["https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.2/LLVM-23.1.2-Linux-X64.tar.xz"],
    },
)
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")

git_override(
    module_name = "bazel_clang_tidy",
    commit = "c4d35e0d0b838309358e57a2efed831780f85cd0",
    remote = "https://github.com/erenon/bazel_clang_tidy.git",
)

git_override(
    module_name = "hedron_compile_commands",
    commit = "078ba7675c05bea2666c92d9a8abe200d8547655",
    remote = "https://github.com/helly25/bazel-compile-commands-extractor.git",
)

archive_override(
    module_name = "googlesql",
    integrity = "sha256-Bi6Z2jQDKs31HB2VR5ds72HKT4PaQqSHYDqi4/JJJX4=",
    strip_prefix = "googlesql-2026.9.2",
    urls = ["https://github.com/google/googlesql/archive/refs/tags/2026.9.2.tar.gz"],
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Prebuilt libduckdb per platform; //third_party/duckdb selects the one for the target platform,
# so only that archive is downloaded.
http_archive(
    name = "duckdb_prebuilt_macos_universal",
    build_file = "//third_party/duckdb:BUILD.duckdb_macos.bazel",
    sha256 = "7b5b8915cc382d0708636fe6385c0cdad5a61c9ff8ba2638b3e2141640783155",
    urls = ["https://github.com/duckdb/duckdb/releases/download/v1.5.5/libduckdb-osx-universal.zip"],
)

http_archive(
    name = "duckdb_prebuilt_linux_amd64",
    build_file = "//third_party/duckdb:BUILD.duckdb_linux.bazel",
    sha256 = "1fb8ce388157d84a25abe685a8a2520bf00c00321821968e4bb398fd766e7abb",
    urls = ["https://github.com/duckdb/duckdb/releases/download/v1.5.5/libduckdb-linux-amd64.zip"],
)

http_archive(
    name = "duckdb_prebuilt_linux_arm64",
    build_file = "//third_party/duckdb:BUILD.duckdb_linux.bazel",
    sha256 = "abe4f6f005ee0b448a058322f4263584b4bd1b6faf7ab4637b79eeaf978f8e9c",
    urls = ["https://github.com/duckdb/duckdb/releases/download/v1.5.5/libduckdb-linux-arm64.zip"],
)
