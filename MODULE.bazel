# Correctly rounded atan2, sin and cos for converting between degrees and S2Point; see
# third_party/core_math.
http_archive(
    name = "core_math",
    build_file = "//third_party/core_math:BUILD.core_math.bazel",
    sha256 = "52cad8445f872ac5f169a9804a5a5c7ce97c1159c6d5d203131c68586269dc76",
    strip_prefix = "core-math-e3f1fcc7daf46c61332357fac591e19e88902926",
    urls = ["https://gitlab.inria.fr/core-math/core-math/-/archive/e3f1fcc7daf46c61332357fac591e19e88902926/core-math-e3f1fcc7daf46c61332357fac591e19e88902926.tar.gz"],
)

# Prebuilt static libduckdb per platform, linked into the binary; //third_party/duckdb selects the
# one for the target platform, so only that archive is downloaded. DuckDB v2's ICU extension
# no longer embeds ICU, so the UCaseMap symbol localization used with v1 is unnecessary.
http_archive(
    name = "duckdb_prebuilt_macos_arm64",
    build_file = "//third_party/duckdb:BUILD.duckdb.bazel",
    sha256 = "c3a571e6d4a0da97534c631df463ab13c07f8cf78049625f5df936b7beaab9ce",
    urls = [
        "https://install.duckdb.org/v2.0.0/duckdb-static-libs-osx-arm64.tar.gz",
        "https://github.com/duckdb/duckdb/releases/download/v2.0.0/duckdb-static-libs-osx-arm64.tar.gz",
    ],
)

http_archive(
    name = "duckdb_prebuilt_linux_amd64",
    build_file = "//third_party/duckdb:BUILD.duckdb.bazel",
    sha256 = "112d62c980f5447cd303a70b3dacbc09acd41ccb4ef6d154e8629f543a0f8568",
    urls = [
        "https://install.duckdb.org/v2.0.0/duckdb-static-libs-linux-amd64.tar.gz",
        "https://github.com/duckdb/duckdb/releases/download/v2.0.0/duckdb-static-libs-linux-amd64.tar.gz",
    ],
)

http_archive(
    name = "duckdb_prebuilt_linux_arm64",
    build_file = "//third_party/duckdb:BUILD.duckdb.bazel",
    sha256 = "8171b4842e68a85b2e82b342d3bf7b542a88fd6666e0c18438d7b459012494ee",
    urls = [
        "https://install.duckdb.org/v2.0.0/duckdb-static-libs-linux-arm64.tar.gz",
        "https://github.com/duckdb/duckdb/releases/download/v2.0.0/duckdb-static-libs-linux-arm64.tar.gz",
    ],
)

# DuckDB's postgres_scanner extension, compiled against the C++ headers of the same DuckDB release
# as the prebuilt libraries and linked into the binary; see third_party/duckdb_postgres. The
# extension and database-connector commits are those DuckDB v2.0.0 pins in
# .github/config/extensions/postgres_scanner.cmake and in the extension's submodule.
http_archive(
    name = "duckdb_source",
    build_file = "//third_party/duckdb_postgres:BUILD.duckdb_source.bazel",
    sha256 = "7e89053255046bfb26afbd7f524a2fb84df7dbef496aa911ea35e4a1182fdc00",
    strip_prefix = "duckdb-2.0.0",
    urls = ["https://github.com/duckdb/duckdb/archive/refs/tags/v2.0.0.tar.gz"],
)

http_archive(
    name = "duckdb_postgres",
    build_file = "//third_party/duckdb_postgres:BUILD.duckdb_postgres.bazel",
    sha256 = "f887a835e224e2b3134d9bc67f77efbca6a5a09f7d575aac13df91cfd26a84f3",
    strip_prefix = "duckdb-postgres-c0f5a3c0c4b68b02afbf669d36d7f0e503985c88",
    urls = ["https://github.com/duckdb/duckdb-postgres/archive/c0f5a3c0c4b68b02afbf669d36d7f0e503985c88.tar.gz"],
)

http_archive(
    name = "duckdb_database_connector",
