    strip_prefix = "duckdb-mysql-f7fc0d42716534aa5ad48626d21ced9807b33967",
    urls = ["https://github.com/duckdb/duckdb-mysql/archive/f7fc0d42716534aa5ad48626d21ced9807b33967.tar.gz"],
