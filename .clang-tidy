Checks:
  - abseil-duration-*
  - abseil-no-internal-dependencies
  - abseil-redundant-strcat-calls
  - abseil-str-cat-append
  - abseil-time-comparison
  - abseil-time-subtraction
  - abseil-upgrade-duration-conversions
  - bugprone-*
  - cert-*
  - clang-analyzer-*
  - concurrency-*
  - cppcoreguidelines-*
  - google-*
  - misc-*
  - modernize-*
  - performance-*
  - portability-*
  - readability-*

  # Headers are linted as their own translation unit by the clang-tidy Bazel aspect, which makes
  # every '#pragma once' look like it sits in a main file.
  - -clang-diagnostic-pragma-once-outside-header
  - -portability-avoid-pragma-once
  # googlesql deprecated ParseTreeVisitor in favour of a status based visitor, but its own
  # Unparser (which the translator extends) still derives from the deprecated one, so every
  # ASTNode::Accept call would be an error here. Ordinary builds still print them as warnings.
  - -clang-diagnostic-deprecated-declarations

  # Not followed yet. Enabling one means fixing what it finds first, along with its aliases, such
  # as hicpp-avoid-c-arrays for modernize-avoid-c-arrays.
  - -cppcoreguidelines-avoid-c-arrays
  - -cppcoreguidelines-avoid-const-or-ref-data-members
  - -cppcoreguidelines-avoid-magic-numbers
  - -cppcoreguidelines-non-private-member-variables-in-classes
  - -cppcoreguidelines-owning-memory
  - -cppcoreguidelines-pro-bounds-array-to-pointer-decay
  - -cppcoreguidelines-pro-bounds-constant-array-index
  - -cppcoreguidelines-pro-bounds-pointer-arithmetic
  - -misc-const-correctness
  - -misc-no-recursion
  - -misc-non-private-member-variables-in-classes
  - -modernize-avoid-c-arrays
  - -modernize-use-designated-initializers
  - -modernize-use-nodiscard
  - -modernize-use-trailing-return-type
  - -readability-braces-around-statements
  - -readability-function-cognitive-complexity
  - -readability-identifier-length
  - -readability-magic-numbers

  # Left out on purpose.
  # It mostly flags libc++'s std::ranges function objects.
  - -cert-err58-cpp
  # getenv and setenv are how the GCS client is configured, and only tests change them.
  - -concurrency-mt-unsafe
  # DuckDB's C API takes bytes as uint8_t and frees const strings through void*.
  - -cppcoreguidelines-pro-type-const-cast
  - -cppcoreguidelines-pro-type-reinterpret-cast
  # server.cc uses most of the server namespace.
  - -google-build-using-namespace
  # Chained conditionals read as a table.
  - -readability-avoid-nested-conditional-operator
  # '= {}' keeps designated initializers from warning about the members they leave out.
  - -readability-redundant-member-init
HeaderFilterRegex: '^(src|tests|tools)/'
CheckOptions:
  # A deleted copy operation and a destructor already make a type non-movable. Abstract
  # interfaces with only a defaulted destructor need no other special members either.
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted: true
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  # GoogleSQL's TYPE_* enumerators and umbrella headers, and nlohmann's json_fwd/json.hpp
  # split, produce false positives. glibc's sigset_t is provided by the public signal.h;
  # include-cleaner instead asks for its internal bits/types/sigset_t.h. On macOS it
  # asks for sys/_types/_sigset_t.h and sys/signal.h (SIG_BLOCK) instead of signal.h.
  misc-include-cleaner.IgnoreHeaders: '(googlesql|nlohmann)/.*|bits/types/sigset_t\.h|sys/_types/_sigset_t\.h|sys/signal\.h'
  # JSON's subscript inserts missing object keys and grows arrays, just as map's inserts keys.
  # at() would change that behavior. Keep the standard map exclusions as well.
  cppcoreguidelines-pro-bounds-avoid-unchecked-container-access.ExcludeClasses: '::std::map;::std::unordered_map;::std::flat_map;::nlohmann::.*basic_json'
# Findings must fail the Bazel action rather than cache a successful lint result.
WarningsAsErrors: '*'
FormatStyle: file
