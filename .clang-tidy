Checks:
  - bugprone-*
  - cert-*
  - clang-analyzer-*
  - concurrency-*
  - cppcoreguidelines-*
  - google-*
  - hicpp-*
  - misc-*
  - modernize-*
  - performance-*
  - portability-*
  - readability-*

  # Headers are linted as their own translation unit by the clang-tidy Bazel aspect, which makes
  # every '#pragma once' look like it sits in a main file.
  - -clang-diagnostic-pragma-once-outside-header
  - -portability-avoid-pragma-once
  # googlesql deprecated ParseTreeVisitor in favour of a status based visitor, but its own
  # Unparser (which the translator extends) still derives from the deprecated one, so every
  # ASTNode::Accept call would be an error here. Ordinary builds still print them as warnings.
  - -clang-diagnostic-deprecated-declarations

  # Not followed yet. Enabling one means fixing what it finds first, along with its aliases, such
  # as hicpp-avoid-c-arrays for modernize-avoid-c-arrays.
  - -cppcoreguidelines-avoid-c-arrays
  - -cppcoreguidelines-avoid-const-or-ref-data-members
  - -cppcoreguidelines-avoid-magic-numbers
  - -cppcoreguidelines-non-private-member-variables-in-classes
  - -cppcoreguidelines-owning-memory
  - -cppcoreguidelines-pro-bounds-array-to-pointer-decay
  - -cppcoreguidelines-pro-bounds-constant-array-index
  - -cppcoreguidelines-pro-bounds-pointer-arithmetic
  - -cppcoreguidelines-special-member-functions
  - -hicpp-avoid-c-arrays
  - -hicpp-braces-around-statements
  - -hicpp-no-array-decay
  - -hicpp-signed-bitwise
  - -hicpp-special-member-functions
  - -misc-const-correctness
  - -misc-include-cleaner
  - -misc-no-recursion
  - -misc-non-private-member-variables-in-classes
  - -modernize-avoid-c-arrays
  - -modernize-use-designated-initializers
  - -modernize-use-nodiscard
  - -modernize-use-trailing-return-type
  - -readability-braces-around-statements
  - -readability-function-cognitive-complexity
  - -readability-identifier-length
  - -readability-magic-numbers

  # Left out on purpose.
  # It mostly flags libc++'s std::ranges function objects.
  - -cert-err58-cpp
  # getenv and setenv are how the GCS client is configured, and only tests change them.
  - -concurrency-mt-unsafe
  # DuckDB's C API takes bytes as uint8_t and frees const strings through void*.
  - -cppcoreguidelines-pro-type-const-cast
  - -cppcoreguidelines-pro-type-reinterpret-cast
  # server.cc uses most of the server namespace.
  - -google-build-using-namespace
  # Chained conditionals read as a table.
  - -readability-avoid-nested-conditional-operator
  # '= {}' keeps designated initializers from warning about the members they leave out.
  - -readability-redundant-member-init
HeaderFilterRegex: '^(src|tests)/'
# The aspect runner only prints clang-tidy's log when it exits non-zero, so findings
# have to be errors to be visible at all.
WarningsAsErrors: '*'
FormatStyle: file
