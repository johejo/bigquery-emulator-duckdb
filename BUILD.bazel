# cpp-httplib configured for the emulator. Its settings are macros read by the header-only library,
# so every target that includes httplib.h depends on this one to see the same values.
cc_library(
    name = "httplib",
    # The default backlog of 5 resets connections when clients open many at once, such as
    # parallel queries from a test suite. The kernel caps it at its own limit (SOMAXCONN).
    defines = ["CPPHTTPLIB_LISTEN_BACKLOG=1024"],
    deps = ["@cpp-httplib//:httplib"],
)

