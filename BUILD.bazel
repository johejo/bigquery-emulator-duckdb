    name = "bigquery-emulator-duckdb",
    srcs = ["src/main.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":emulator",
        ":server",
    ],
)

# Prints docs/functions.md, a report of which BigQuery functions the emulator translates and runs.
cc_binary(
    name = "function_probe",
    srcs = ["tools/function_probe.cc"],
    copts = ["-std=c++20"],
    target_compatible_with = MACOS_ONLY,
    deps = [
        ":analyzer",
        ":catalog",
        ":emulator",
        "@googlesql//googlesql/public:function",
        "@googlesql//googlesql/public:type",
    ],
)

genrule(
    name = "functions_md",
    srcs = [
        "tools/bigquery_functions.txt",
        "tools/function_probe_hints.txt",
    ],
    outs = ["functions.md"],
    cmd = "$(execpath :function_probe) $(execpath tools/bigquery_functions.txt) $(execpath tools/function_probe_hints.txt) > $@",
    target_compatible_with = MACOS_ONLY,
    tools = [":function_probe"],
)

diff_test(
    name = "functions_md_test",
    failure_message = "docs/functions.md is stale; run `just docs` to regenerate it.",
    file1 = ":functions_md",
    file2 = "docs/functions.md",
    target_compatible_with = MACOS_ONLY,
)

