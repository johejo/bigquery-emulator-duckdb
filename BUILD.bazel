# The emulator's libraries, shared with the packages under src/ that hold its components. Each
# package checks that its sources include only headers of the targets they depend on directly.
package(
    default_visibility = ["//src:__subpackages__"],
    features = ["layering_check"],
)

refresh_compile_commands(
    name = "refresh_compile_commands",
    exclude_external_sources = True,
    exclude_headers = "external",
    targets = {
        ":backend_test": "",
        ":catalog_test": "",
        ":emulator_test": "",
        ":functions_test": "",
        ":query_parameters_test": "",
        ":translator_test": "",
        ":bigquery-emulator-duckdb": "",
        ":server_test": "",
    },
)

filegroup(
    name = "clang_tidy_config",
    srcs = [
