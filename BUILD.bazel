load("@hedron_compile_commands//:refresh_compile_commands.bzl", "refresh_compile_commands")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

refresh_compile_commands(
    name = "refresh_compile_commands",
    exclude_external_sources = True,
    exclude_headers = "external",
    targets = {
        "//:backend_test": "",
        "//:bigquery-emulator-duckdb": "",
        "//:server_test": "",
        "//:translator_test": "",
    },
)

filegroup(
    name = "clang_tidy_config",
    srcs = [".clang-tidy"],
    visibility = ["//visibility:public"],
)

MACOS_ONLY = select({
    "@platforms//os:macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_library(
    name = "api_error",
    hdrs = ["src/api_error.h"],
    copts = ["-std=c++20"],
)

cc_library(
    name = "frontend",
    srcs = ["src/frontend.cc"],
    hdrs = ["src/frontend.h"],
    copts = ["-std=c++20"],
    deps = [
        "@googlesql//googlesql/public:parse_helpers",
    ],
)

cc_library(
    name = "translator",
    srcs = ["src/translator.cc"],
    hdrs = ["src/translator.h"],
    copts = ["-std=c++20"],
    deps = [":frontend"],
)

cc_library(
    name = "backend",
    srcs = ["src/backend.cc"],
    hdrs = ["src/backend.h"],
    copts = ["-std=c++20"],
    linkopts = select({
        "@platforms//os:macos": ["-Wl,-rpath,@loader_path"],
        "//conditions:default": [],
    }),
    target_compatible_with = MACOS_ONLY,
    deps = [
        "@duckdb_prebuilt_macos_universal//:duckdb",
        "@nlohmann_json//:json",
    ],
)

cc_library(
    name = "emulator",
    srcs = ["src/emulator.cc"],
    hdrs = ["src/emulator.h"],
    copts = ["-std=c++20"],
    target_compatible_with = MACOS_ONLY,
    deps = [
        ":api_error",
        ":backend",
        ":frontend",
        ":translator",
        "@nlohmann_json//:json",
    ],
)

cc_library(
    name = "discovery_document",
    srcs = ["//third_party/bigquery:discovery_document.cc"],
    hdrs = ["src/discovery_document.h"],
    copts = ["-std=c++20"],
)

cc_library(
    name = "server",
    srcs = ["src/server.cc"],
    hdrs = ["src/server.h"],
    copts = ["-std=c++20"],
    target_compatible_with = MACOS_ONLY,
    deps = [
        ":api_error",
        ":discovery_document",
        ":emulator",
        "@cpp-httplib//:httplib",
        "@nlohmann_json//:json",
    ],
)

cc_binary(
    name = "bigquery-emulator-duckdb",
    srcs = ["src/main.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":emulator",
        ":server",
    ],
)

cc_test(
    name = "translator_test",
    srcs = ["tests/translator_test.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":frontend",
        ":translator",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_test(
    name = "backend_test",
    srcs = ["tests/backend_test.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":backend",
        "@com_google_googletest//:gtest_main",
        "@nlohmann_json//:json",
    ],
)

cc_test(
    name = "server_test",
    srcs = ["tests/server_test.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":emulator",
        ":server",
        "@com_google_googletest//:gtest_main",
        "@cpp-httplib//:httplib",
        "@nlohmann_json//:json",
    ],
)
