# Shared by the probes that print docs/functions.md, docs/sql.md and docs/api.md.
cc_library(
    name = "probe",
    srcs = ["tools/probe.cc"],
    hdrs = ["tools/probe.h"],
    copts = ["-std=c++20"],
    deps = [
        ":analyzer",
        ":catalog",
        ":emulator",
        "@googlesql//googlesql/public:type",
    ],
)

cc_binary(
    name = "function_probe",
    srcs = ["tools/function_probe.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":catalog",
        ":emulator",
        ":probe",
        "@googlesql//googlesql/public:function",
        "@googlesql//googlesql/public:type",
    ],
)

genrule(
    name = "functions_md",
    srcs = [
        "tools/bigquery_functions.txt",
        "tools/function_probe_hints.txt",
    ],
    outs = ["functions.md"],
    cmd = "$(execpath :function_probe) $(execpath tools/bigquery_functions.txt) $(execpath tools/function_probe_hints.txt) > $@",
    tools = [":function_probe"],
)

diff_test(
    name = "functions_md_test",
    failure_message = "docs/functions.md is stale; run `just docs` to regenerate it.",
    file1 = ":functions_md",
    file2 = "docs/functions.md",
)

cc_binary(
    name = "sql_probe",
    srcs = ["tools/sql_probe.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":api_error",
        ":catalog",
        ":emulator",
        ":probe",
    ],
)

genrule(
    name = "sql_md",
    srcs = ["tools/sql_features.txt"],
    outs = ["sql.md"],
    cmd = "$(execpath :sql_probe) $(execpath tools/sql_features.txt) > $@",
    tools = [":sql_probe"],
)

