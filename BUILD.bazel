load("@hedron_compile_commands//:refresh_compile_commands.bzl", "refresh_compile_commands")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

refresh_compile_commands(
    name = "refresh_compile_commands",
    exclude_external_sources = True,
    exclude_headers = "external",
    targets = {
        "//:backend_test": "",
        "//:emulator_test": "",
        "//:query_parameters_test": "",
        "//:bigquery-emulator-duckdb": "",
        "//:server_test": "",
        "//:translator_test": "",
    },
)

filegroup(
    name = "clang_tidy_config",
    srcs = [".clang-tidy"],
    visibility = ["//visibility:public"],
)

MACOS_ONLY = select({
    "@platforms//os:macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_library(
    name = "api_error",
    hdrs = ["src/api_error.h"],
    copts = ["-std=c++20"],
)

cc_library(
    name = "duckdb_sql",
    srcs = ["src/duckdb_sql.cc"],
    hdrs = ["src/duckdb_sql.h"],
    copts = ["-std=c++20"],
)

cc_library(
    name = "functions",
    srcs = ["src/functions.cc"],
    hdrs = ["src/functions.h"],
    copts = ["-std=c++20"],
)

cc_library(
    name = "query_parameters",
    srcs = ["src/query_parameters.cc"],
    hdrs = ["src/query_parameters.h"],
    copts = ["-std=c++20"],
    deps = [
        ":api_error",
        ":duckdb_sql",
        "@nlohmann_json//:json",
    ],
)

cc_library(
    name = "frontend",
    srcs = ["src/frontend.cc"],
    hdrs = ["src/frontend.h"],
    copts = ["-std=c++20"],
    deps = [
        "@googlesql//googlesql/public:error_helpers",
        "@googlesql//googlesql/public:language_options",
        "@googlesql//googlesql/public:parse_helpers",
    ],
)

cc_library(
    name = "translator",
    srcs = ["src/translator.cc"],
    hdrs = ["src/translator.h"],
    copts = ["-std=c++20"],
    deps = [
        ":duckdb_sql",
        ":frontend",
        ":functions",
        ":query_parameters",
        # The parser AST and the unparser live in //googlesql/parser, which is visible only
        # inside googlesql; they come in transitively through these public targets.
        "@googlesql//googlesql/public:parse_helpers",
        "@googlesql//googlesql/public:type",
    ],
)

cc_library(
    name = "backend",
    srcs = ["src/backend.cc"],
    hdrs = ["src/backend.h"],
    copts = ["-std=c++20"],
    linkopts = select({
        "@platforms//os:macos": ["-Wl,-rpath,@loader_path"],
        "//conditions:default": [],
    }),
    target_compatible_with = MACOS_ONLY,
    deps = [
        "@duckdb_prebuilt_macos_universal//:duckdb",
        "@nlohmann_json//:json",
    ],
)

cc_library(
    name = "emulator",
    srcs = ["src/emulator.cc"],
    hdrs = ["src/emulator.h"],
    copts = ["-std=c++20"],
    target_compatible_with = MACOS_ONLY,
    deps = [
        ":api_error",
        ":backend",
        ":duckdb_sql",
        ":frontend",
        ":query_parameters",
        ":translator",
        "@nlohmann_json//:json",
    ],
)

cc_library(
    name = "discovery_document",
    srcs = ["//third_party/bigquery:discovery_document.cc"],
    hdrs = ["src/discovery_document.h"],
    copts = ["-std=c++20"],
)

cc_library(
    name = "server",
    srcs = ["src/server.cc"],
    hdrs = ["src/server.h"],
    copts = ["-std=c++20"],
    target_compatible_with = MACOS_ONLY,
    deps = [
        ":api_error",
        ":discovery_document",
        ":emulator",
        ":query_parameters",
        "@cpp-httplib//:httplib",
        "@nlohmann_json//:json",
    ],
)

cc_binary(
    name = "bigquery-emulator-duckdb",
    srcs = ["src/main.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":emulator",
        ":server",
    ],
)

cc_test(
    name = "translator_test",
    srcs = ["tests/translator_test.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":frontend",
        ":query_parameters",
        ":translator",
        "@com_google_googletest//:gtest_main",
        "@nlohmann_json//:json",
    ],
)

cc_test(
    name = "emulator_test",
    srcs = ["tests/emulator_test.cc"],
    copts = ["-std=c++20"],
    target_compatible_with = MACOS_ONLY,
    deps = [
        ":emulator",
        "@com_google_googletest//:gtest_main",
        "@nlohmann_json//:json",
    ],
)

cc_test(
    name = "query_parameters_test",
    srcs = ["tests/query_parameters_test.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":api_error",
        ":query_parameters",
        "@com_google_googletest//:gtest_main",
        "@nlohmann_json//:json",
    ],
)

cc_test(
    name = "backend_test",
    srcs = ["tests/backend_test.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":backend",
        "@com_google_googletest//:gtest_main",
        "@nlohmann_json//:json",
    ],
)

cc_test(
    name = "server_test",
    srcs = ["tests/server_test.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":emulator",
        ":server",
        "@com_google_googletest//:gtest_main",
        "@cpp-httplib//:httplib",
        "@nlohmann_json//:json",
    ],
)
