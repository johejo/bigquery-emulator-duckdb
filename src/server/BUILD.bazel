load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(features = ["layering_check"])

cc_library(
    name = "routes",
    srcs = ["routes.cc"],
    hdrs = ["routes.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        "//:api_error",
        "//:discovery_document",
        "//:httplib",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
    deps = ["@nlohmann_json//:json"],
)

cc_library(
    name = "requests",
    srcs = ["requests.cc"],
    hdrs = ["requests.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":routes",
        "//:api_error",
        "//:httplib",
        "//:query_parameters",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
    deps = [
        "//:emulator",
        "//:field_schema",
        "//:references",
        "//:routine",
        "//:table_metadata",
        "@nlohmann_json//:json",
    ],
)

cc_library(
    name = "resources",
    srcs = ["resources.cc"],
    hdrs = ["resources.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":requests",
        "//:api_error",
        "//:backend",
        "//:emulator",
        "//:field_schema",
        "//:project",
        "//:references",
        "//:routine",
        "//:table_metadata",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
    deps = ["@nlohmann_json//:json"],
)

cc_library(
    name = "rest",
    srcs = ["rest.cc"],
    hdrs = ["rest.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":requests",
        ":resources",
        ":routes",
        "//:api_error",
        "//:emulator",
        "//:httplib",
        "//:references",
        "//:table_metadata",
        "//:temporary_files",
        "@nlohmann_json//:json",
    ],
    visibility = ["//:__pkg__"],
)
