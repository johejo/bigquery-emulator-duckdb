load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "routes",
    srcs = ["routes.cc"],
    copts = ["-std=c++20"],
    implementation_deps = [
        "//:api_error",
        "//:discovery_document",
        "//:httplib",
        "@nlohmann_json//:json",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
    deps = [":routes_interface"],
)

cc_library(
    name = "requests",
    srcs = ["requests.cc"],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":routes",
        "//:api_error",
        "//:emulator_interface",
        "//:field_schema",
        "//:httplib",
        "//:query_parameters",
        "//:references",
        "//:table_metadata",
        "@nlohmann_json//:json",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
    deps = [":requests_interface"],
)

cc_library(
    name = "resources",
    srcs = ["resources.cc"],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":requests_interface",
        "//:api_error",
        "//:emulator_interface",
        "//:field_schema",
        "//:project",
        "//:references",
        "//:table_metadata",
        "@nlohmann_json//:json",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
    deps = [":resources_interface"],
)

cc_library(
    name = "routes_interface",
    hdrs = ["routes.h"],
    deps = ["@nlohmann_json//:json"],
)

cc_library(
    name = "requests_interface",
    hdrs = ["requests.h"],
    deps = [
        "//:emulator_interface",
        "//:field_schema",
        "//:references",
        "//:table_metadata",
        "@nlohmann_json//:json",
    ],
)

cc_library(
    name = "resources_interface",
    hdrs = ["resources.h"],
    deps = ["@nlohmann_json//:json"],
)
