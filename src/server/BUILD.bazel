load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(features = ["layering_check"])

cc_library(
    name = "storage_codec",
    srcs = ["storage_codec.cc"],
    hdrs = ["storage_codec.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        "//:api_error",
        "//src/googlesql_geography",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/time",
        "@googlesql//googlesql/common:utf_util",
        "@googlesql//googlesql/public:civil_time",
        "@googlesql//googlesql/public:numeric_value",
        "@googlesql//googlesql/public/functions:date_time_util",
    ],
    deps = [
        "//:field_schema",
        "@nlohmann_json//:json",
        "@protobuf",
    ],
)

cc_library(
    name = "storage",
    srcs = ["storage.cc"],
    hdrs = ["storage.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":storage_codec",
        "//:api_error",
        "//:backend",
        "//:emulator",
        "//:field_schema",
        "//:project",
        "//:references",
        "//:storage_read_codec",
        "@abseil-cpp//absl/log:absl_log",
        "@googleapis//google/cloud/bigquery/storage/v1:storage_cc_grpc",
        "@googleapis//google/cloud/bigquery/storage/v1:storage_cc_proto",
        "@grpc//:channel_arg_names",
        "@grpc//:grpc++",
        "@nlohmann_json//:json",
        "@protobuf",
        "@protobuf//:timestamp_cc_proto",
    ],
    visibility = ["//:__pkg__"],
)

cc_library(
    name = "routes",
    srcs = ["routes.cc"],
    hdrs = ["routes.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        "//:api_error",
        "//:discovery_document",
        "//:httplib",
        "@googleapis//google/cloud/bigquery/v2:bigquery_cc_proto",
        "@protobuf",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
    deps = ["@nlohmann_json//:json"],
)

cc_library(
    name = "requests",
    srcs = ["requests.cc"],
    hdrs = ["requests.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        "//:api_error",
        "//:httplib",
        "//:query_parameters",
        "@abseil-cpp//absl/log:absl_log",
        "@abseil-cpp//absl/time",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
    deps = [
        ":routes",
        "//:emulator",
        "//:field_schema",
        "//:references",
        "//:routine",
        "//:table_metadata",
        "@nlohmann_json//:json",
    ],
)

cc_library(
    name = "resources",
    srcs = ["resources.cc"],
    hdrs = ["resources.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":requests",
        ":routes",
        "//:api_error",
        "//:backend",
        "//:emulator",
        "//:field_schema",
        "//:project",
        "//:references",
        "//:result_rows",
        "//:routine",
        "//:table_metadata",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
    deps = ["@nlohmann_json//:json"],
)

cc_library(
    name = "rest",
    srcs = ["rest.cc"],
    hdrs = ["rest.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":requests",
        ":resources",
        ":routes",
        "//:api_error",
        "//:emulator",
        "//:httplib",
        "//:logging",
        "//:references",
        "//:table_metadata",
        "//:temporary_files",
        "@abseil-cpp//absl/log:absl_log",
        "@nlohmann_json//:json",
    ],
    visibility = ["//:__pkg__"],
)
