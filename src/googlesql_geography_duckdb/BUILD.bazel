load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(features = ["layering_check"])

cc_library(
    name = "codec",
    srcs = ["codec.cc"],
    hdrs = ["codec.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        "@abseil-cpp//absl/status",
        "@s2geometry//:s2",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
    deps = [
        "//src/googlesql_geography",
        "@abseil-cpp//absl/status:statusor",
    ],
)

cc_library(
    name = "googlesql_geography_duckdb",
    srcs = ["geography.cc"],
    hdrs = [
        "functions.h",
        "geography.h",
    ],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":codec",
        "//:backend_error",
        "//:duckdb_handle",
        "//:duckdb_sql",
        "//src/duckdb_functions:register",
        "//src/duckdb_functions:scalar",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@googlesql//googlesql/base:status",
        "@googlesql//googlesql/public:type_cc_proto",
        "@s2geometry//:s2",
    ],
    linkstatic = True,
    visibility = [
        "//:__pkg__",
    ],
    deps = [
        "//src/function_catalog",
        "//src/googlesql_geography",
        "//third_party/duckdb",
    ],
)
