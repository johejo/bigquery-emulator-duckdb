load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(features = ["layering_check"])

cc_library(
    name = "register",
    srcs = ["register.cc"],
    hdrs = ["register.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        "//:backend_error",
        "//:duckdb_handle",
    ],
    linkstatic = True,
    visibility = ["//src:__subpackages__"],
    deps = ["//third_party/duckdb"],
)

cc_library(
    name = "apply",
    hdrs = ["apply.h"],
    visibility = ["//src:__subpackages__"],
    deps = [
        ":scalar",
        "//:bignumeric",
        "//:duckdb_handle",
        "//:interval",
        "//third_party/duckdb",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/types:span",
        "@googlesql//googlesql/public:interval_value",
        "@googlesql//googlesql/public:numeric_value",
    ],
)

cc_library(
    name = "scalar",
    hdrs = ["scalar.h"],
    visibility = ["//src:__subpackages__"],
    deps = [
        "//:duckdb_handle",
        "@googlesql//googlesql/base:status",
    ],
)
