load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(features = ["layering_check"])

# Backend-independent registry data, rule construction and SQL expansion.
cc_library(
    name = "function_catalog",
    srcs = [
        "catalog.cc",
        "comparison.cc",
        "resolved_access.cc",
        "rule_builders.cc",
        "rules.cc",
    ],
    hdrs = [
        "catalog.h",
        "comparison.h",
        "resolved_access.h",
        "rule_builders.h",
        "rules.h",
        "static_definitions.h",
    ],
    copts = ["-std=c++20"],
    implementation_deps = [
        "//:duckdb_sql",
        "@googlesql//googlesql/analyzer:resolver",
        "@googlesql//googlesql/public:function",
        "@googlesql//googlesql/public:type",
        "@googlesql//googlesql/public:value",
        "@googlesql//googlesql/resolved_ast",
    ],
    linkstatic = True,
    visibility = ["//:__subpackages__"],
    deps = [
        "//:timestamp_precision",
        "@googlesql//googlesql/public:type_cc_proto",
    ],
)
