load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(features = ["layering_check"])

# Line editing on a terminal; knows nothing of queries, so that the editor can be replaced alone.
cc_library(
    name = "line_reader",
    srcs = ["line_reader.cc"],
    hdrs = ["line_reader.h"],
    copts = ["-std=c++20"],
    implementation_deps = ["@linenoise"],
    visibility = [":__pkg__"],
)

# Writing query results; knows nothing of the emulator but the jobs.query response.
cc_library(
    name = "format",
    srcs = ["format.cc"],
    hdrs = ["format.h"],
    copts = ["-std=c++20"],
    visibility = ["//:__pkg__"],
    deps = ["@nlohmann_json//:json"],
)

# The interactive loop, which leaves parsing and running entries to its caller.
cc_library(
    name = "repl",
    srcs = ["repl.cc"],
    hdrs = ["repl.h"],
    copts = ["-std=c++20"],
    implementation_deps = [":line_reader"],
    visibility = ["//:__pkg__"],
)
