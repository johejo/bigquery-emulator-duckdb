load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(features = ["layering_check"])

cc_library(
    name = "googlesql_text_analysis",
    srcs = ["text_analysis.cc"],
    hdrs = ["text_analysis.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:string_view",
        "@googlesql//googlesql/base:status",
        "@googlesql//googlesql/public/functions:normalize_mode_cc_proto",
        "@googlesql//googlesql/public/functions:regexp",
        "@googlesql//googlesql/public/functions:string",
        # GoogleSQL's regexp brings in the single-header copy, which the include finds first.
        "@nlohmann_json//:singleheader-json",
        "@re2",
    ],
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
    ],
)
