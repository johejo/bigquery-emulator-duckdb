load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
)

cc_library(
    name = "javascript",
    srcs = ["javascript.cc"],
    hdrs = ["javascript.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        "//:backend_error",
        "//:duckdb_handle",
        "//src/duckdb_functions:scalar",
        "//src/udf/javascript:engine",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@quickjs-ng//:quickjs",
        "@quickjs-ng//:quickjs_hdrs",
    ],
    linkstatic = True,
    deps = [
        "//src/udf/javascript:limits",
        "//third_party/duckdb",
    ],
)

cc_library(
    name = "python",
    srcs = ["python.cc"],
    hdrs = ["python.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        "//:backend_error",
        "//:duckdb_handle",
        "//src/duckdb_functions:scalar",
        "//src/udf/python:worker",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@nlohmann_json//:json",
    ],
    linkstatic = True,
    deps = [
        "//src/udf/python:options",
        "//third_party/duckdb",
    ],
)
