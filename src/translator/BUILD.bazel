# Headers separate from their implementations, which depend on each other: expressions contain
# subqueries, scans contain expressions, and the registry in functions.cc names handlers in
# function.cc, which looks up the registry.
cc_library(
    name = "functions_interface",
    hdrs = ["functions.h"],
    visibility = ["//:__pkg__"],
    deps = ["@googlesql//googlesql/public:type_cc_proto"],
)

