load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(features = ["layering_check"])

cc_library(
    name = "context",
    hdrs = ["context.h"],
    visibility = ["//:__pkg__"],
    deps = [
        "//:duckdb_sql",
        "//:query_parameters",
        "//:references",
        "//:system_variables",
        "//:translated_statement",
    ],
)

# Queries and expressions, which contain each other: expressions contain subqueries, scans contain
# expressions, aggregates and function calls, and function calls contain expressions.
cc_library(
    name = "query",
    srcs = [
        "aggregate.cc",
        "expression.cc",
        "function.cc",
        "scan.cc",
    ],
    hdrs = [
        "aggregate.h",
        "expression.h",
        "function.h",
        "scan.h",
    ],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":functions",
        ":literal",
        "//:catalog",
        "//:duckdb_sql",
        "//:javascript_function",
        "//:type_mapping",
        "@abseil-cpp//absl/status:statusor",
        "@googlesql//googlesql/base:status",
        "@googlesql//googlesql/public:analyzer",
        "@googlesql//googlesql/public:catalog",
        "@googlesql//googlesql/public:constant",
        "@googlesql//googlesql/public:function",
        "@googlesql//googlesql/public:type",
        "@googlesql//googlesql/public:value",
        "@googlesql//googlesql/resolved_ast",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
    deps = [":context"],
)

# The registry of BigQuery functions and how each is spelled in DuckDB: as is, renamed, by
# template rules or backend rules, or by a handler.
cc_library(
    name = "functions",
    srcs = [
        "functions.cc",
        "functions_aggregate.cc",
        "functions_backend.cc",
        "functions_internal.cc",
        "functions_internal.h",
        "functions_template.cc",
        "handlers.cc",
        "rules.cc",
    ],
    hdrs = [
        "functions.h",
        "handlers.h",
    ],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":context",
        "//:duckdb_sql",
        "//:type_mapping",
        "@googlesql//googlesql/public:function",
        "@googlesql//googlesql/public:type",
        "@googlesql//googlesql/public:value",
        "@googlesql//googlesql/resolved_ast",
        "@nlohmann_json//:json",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
    deps = ["@googlesql//googlesql/public:type_cc_proto"],
)

cc_library(
    name = "literal",
    srcs = ["literal.cc"],
    hdrs = ["literal.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":context",
        "//:bignumeric",
        "//:catalog",
        "//:duckdb_sql",
        "//:type_mapping",
        "@googlesql//googlesql/public:interval_value",
        "@googlesql//googlesql/public:strings",
        "@googlesql//googlesql/public:type",
        "@googlesql//googlesql/public:value",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
)

cc_library(
    name = "ddl",
    srcs = [
        "ddl.cc",
        "ddl_internal.h",
        "ddl_options.cc",
        "ddl_routine.cc",
        "ddl_schema.cc",
        "ddl_table.cc",
        "ddl_view.cc",
    ],
    hdrs = ["ddl.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":query",
        "//:catalog",
        "//:duckdb_sql",
        "//:field_schema",
        "//:references",
        "//:table_metadata",
        "//:translated_statement",
        "//:type_mapping",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/time",
        "@googlesql//googlesql/base:status",
        "@googlesql//googlesql/public:function",
        "@googlesql//googlesql/public:type",
        "@googlesql//googlesql/public:value",
        "@googlesql//googlesql/public/types",
        "@googlesql//googlesql/resolved_ast",
        "@nlohmann_json//:json",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
    deps = [":context"],
)

cc_library(
    name = "dml",
    srcs = ["dml.cc"],
    hdrs = ["dml.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":query",
        "//:catalog",
        "//:duckdb_sql",
        "//:type_mapping",
        "@googlesql//googlesql/public:catalog",
        "@googlesql//googlesql/public:type",
        "@googlesql//googlesql/resolved_ast",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
    deps = [":context"],
)
