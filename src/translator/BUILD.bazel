load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(features = ["layering_check"])

cc_library(
    name = "context",
    hdrs = ["context.h"],
    visibility = ["//:__pkg__"],
    deps = [
        "//:duckdb_sql",
        "//:query_parameters",
        "//:references",
        "//:system_variables",
        "//:translated_statement",
    ],
)

# Queries and expressions, which contain each other: expressions contain subqueries, scans contain
# expressions, aggregates and function calls, and function calls contain expressions.
cc_library(
    name = "query",
    srcs = [
        "aggregate.cc",
        "expression.cc",
        "function.cc",
        "scan.cc",
    ],
    hdrs = [
        "aggregate.h",
        "expression.h",
        "function.h",
        "scan.h",
    ],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":functions",
        ":literal",
        ":resolved_access",
        "//:catalog_table",
        "//:duckdb_sql",
        "//:external_query",
        "//:field_schema",
        "//:javascript_function",
        "//:language_options",
        "//:type_mapping",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@googlesql//googlesql/base:status",
        "@googlesql//googlesql/public:analyzer",
        "@googlesql//googlesql/public:catalog",
        "@googlesql//googlesql/public:constant",
        "@googlesql//googlesql/public:function",
        "@googlesql//googlesql/public:type",
        "@googlesql//googlesql/public:value",
        "@googlesql//googlesql/resolved_ast",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
    deps = [":context"],
)

# The registry of BigQuery functions and how each is spelled in DuckDB: as is, renamed, by
# template rules or backend rules, or by a handler.
cc_library(
    name = "functions",
    srcs = [
        "function_categories.cc",
        "function_rule_builders.cc",
        "function_rule_builders.h",
        "functions.cc",
        "functions_aggregate.cc",
        "functions_aggregate.h",
        "functions_backend.cc",
        "functions_backend.h",
        "functions_template.cc",
        "functions_template.h",
        "handlers.cc",
        "rules.cc",
    ],
    hdrs = [
        "functions.h",
        "handlers.h",
    ],
    copts = ["-std=c++20"],
    # The registry reads the resolved AST only through :resolved_access, so these sources, which
    # change with every function, cannot include its definitions.
    implementation_deps = [
        ":context",
        ":resolved_access",
        "//:duckdb_sql",
        "//:type_mapping",
        "@googlesql//googlesql/public:type",
        "@nlohmann_json//:json",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
    deps = ["@googlesql//googlesql/public:type_cc_proto"],
)

# Arguments, types and literal values of the resolved AST, as the function registry reads them.
cc_library(
    name = "resolved_access",
    srcs = ["resolved_access.cc"],
    hdrs = ["resolved_access.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        "//:duckdb_sql",
        "@googlesql//googlesql/public:function",
        "@googlesql//googlesql/public:type",
        "@googlesql//googlesql/public:value",
        "@googlesql//googlesql/resolved_ast",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
)

cc_library(
    name = "literal",
    srcs = ["literal.cc"],
    hdrs = ["literal.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":context",
        "//:bignumeric",
        "//:duckdb_sql",
        "//:language_options",
        "//:type_mapping",
        "@googlesql//googlesql/public:interval_value",
        "@googlesql//googlesql/public:strings",
        "@googlesql//googlesql/public:type",
        "@googlesql//googlesql/public:value",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
)

# DDL name resolution and metadata options do not depend on query translation.
cc_library(
    name = "ddl_names",
    srcs = ["ddl_names.cc"],
    hdrs = ["ddl_names.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":context",
        "//:duckdb_sql",
        "//:references",
        "//:table_path",
        "//:translated_statement",
    ],
    linkstatic = True,
)

cc_library(
    name = "ddl_options",
    srcs = ["ddl_options.cc"],
    hdrs = ["ddl_options.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":context",
        ":query",
        "//:api_error",
        "//:duckdb_sql",
        "//:field_schema",
        "//:language_options",
        "//:location",
        "//:translated_statement",
        "@abseil-cpp//absl/time",
        "@googlesql//googlesql/public:function",
        "@googlesql//googlesql/public:type",
        "@googlesql//googlesql/resolved_ast",
    ],
    linkstatic = True,
    deps = [
        "//:table_metadata",
        "@googlesql//googlesql/public:value",
    ],
)

cc_library(
    name = "ddl",
    srcs = [
        "ddl.cc",
        "ddl_routine.cc",
        "ddl_schema.cc",
        "ddl_table.cc",
        "ddl_view.cc",
    ],
    hdrs = ["ddl.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":ddl_names",
        ":ddl_options",
        ":query",
        "//:catalog_table",
        "//:duckdb_sql",
        "//:field_schema",
        "//:references",
        "//:table_metadata",
        "//:table_path",
        "//:table_source",
        "//:translated_statement",
        "//:type_mapping",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/time",
        "@googlesql//googlesql/base:status",
        "@googlesql//googlesql/public:function",
        "@googlesql//googlesql/public:type",
        "@googlesql//googlesql/public:value",
        "@googlesql//googlesql/public/types",
        "@googlesql//googlesql/resolved_ast",
        "@nlohmann_json//:json",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
    deps = [":context"],
)

cc_library(
    name = "dml",
    srcs = ["dml.cc"],
    hdrs = ["dml.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":query",
        "//:catalog_table",
        "//:duckdb_sql",
        "//:field_schema",
        "//:type_mapping",
        "@googlesql//googlesql/public:catalog",
        "@googlesql//googlesql/public:type",
        "@googlesql//googlesql/resolved_ast",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
    deps = [":context"],
)

# Statement dispatch depends on query and DDL translation; the public entry points only pass ASTs.
cc_library(
    name = "statement",
    srcs = ["statement.cc"],
    hdrs = ["statement.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":context",
        ":ddl",
        ":dml",
        ":query",
        "//:analyzer",
        "//:duckdb_sql",
        "//:type_mapping",
        "@googlesql//googlesql/public:type",
        "@googlesql//googlesql/resolved_ast",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
)
