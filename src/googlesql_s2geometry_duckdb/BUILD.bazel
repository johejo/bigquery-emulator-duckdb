load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(features = ["layering_check"])

cc_library(
    name = "codec",
    srcs = ["codec.cc"],
    hdrs = ["codec.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        "@abseil-cpp//absl/status",
        "@s2geometry//:s2",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
    deps = [
        "//src/googlesql_s2geometry",
        "@abseil-cpp//absl/status:statusor",
    ],
)

cc_library(
    name = "googlesql_s2geometry_duckdb",
    srcs = ["geography.cc"],
    hdrs = ["geography.h"],
    copts = ["-std=c++20"],
    implementation_deps = [
        ":codec",
        "//:backend_error",
        "//:duckdb_handle",
        "//src/backend_functions:register",
        "//src/backend_functions:scalar",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@googlesql//googlesql/base:status",
        "@s2geometry//:s2",
    ],
    linkstatic = True,
    visibility = ["//:__pkg__"],
    deps = [
        "//src/googlesql_s2geometry",
        "//third_party/duckdb",
    ],
)
