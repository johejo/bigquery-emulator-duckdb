load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
)

cc_library(
    name = "limits",
    hdrs = ["limits.h"],
    copts = ["-std=c++20"],
    linkstatic = True,
)

cc_library(
    name = "engine",
    srcs = ["engine.cc"],
    hdrs = ["engine.h"],
    copts = ["-std=c++20"],
    implementation_deps = ["@quickjs-ng//:quickjs"],
    linkstatic = True,
    deps = [
        ":limits",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@quickjs-ng//:quickjs_hdrs",
    ],
)
