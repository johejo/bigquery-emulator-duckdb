  "contexts": [
    {
      "name": "CREATE SCHEMA",
      "group": "schema_option_list",
      "template": "CREATE SCHEMA e OPTIONS ({option})",
      "implementation": "CREATE SCHEMA"
    },
    {
      "name": "ALTER SCHEMA SET OPTIONS",
      "group": "schema_set_options_list",
      "template": "ALTER SCHEMA d SET OPTIONS ({option})",
      "implementation": "ALTER SCHEMA"
    },
    {
      "name": "CREATE TABLE",
      "group": "table_option_list",
      "template": "CREATE TABLE n (id INT64, d DATE, a NUMERIC) PARTITION BY d OPTIONS ({option})",
      "implementation": "CREATE TABLE"
    },
    {
      "name": "ALTER TABLE SET OPTIONS",
      "group": "table_set_options_list",
      "template": "ALTER TABLE t SET OPTIONS ({option})",
      "implementation": "ALTER TABLE"
    },
    {
      "name": "CREATE TABLE column",
      "group": "column_option_list",
      "template": "CREATE TABLE n (a NUMERIC OPTIONS ({option}))",
      "implementation": "column"
    },
    {
      "name": "ALTER TABLE ADD COLUMN",
      "group": "column_option_list",
      "template": "ALTER TABLE t ADD COLUMN b NUMERIC OPTIONS ({option})",
      "implementation": "column"
    },
    {
      "name": "ALTER TABLE ALTER COLUMN SET OPTIONS",
      "group": "column_set_options_list",
      "template": "ALTER TABLE t ALTER COLUMN a SET OPTIONS ({option})",
      "implementation": "column"
    },
    {
      "name": "CREATE SNAPSHOT TABLE",
      "group": "snapshot_option_list",
      "template": "CREATE SNAPSHOT TABLE n CLONE t OPTIONS ({option})",
      "implementation": "CREATE SNAPSHOT TABLE"
    },
    {
      "name": "CREATE VIEW",
      "group": "view_option_list",
      "template": "CREATE VIEW n OPTIONS ({option}) AS SELECT id FROM t",
      "implementation": "CREATE VIEW"
    },
    {
      "name": "CREATE VIEW column",
      "group": "view_column_option_list",
      "template": "CREATE VIEW n (id OPTIONS ({option})) AS SELECT id FROM t"
    },
    {
      "name": "ALTER VIEW SET OPTIONS",
      "group": "view_set_options_list",
      "template": "ALTER VIEW v SET OPTIONS ({option})",
      "setup": [
        "CREATE VIEW d.v AS SELECT id FROM d.t"
      ]
    },
    {
      "name": "ALTER VIEW ALTER COLUMN SET OPTIONS",
      "group": "view_column_set_options_list",
      "template": "ALTER VIEW v ALTER COLUMN id SET OPTIONS ({option})",
      "setup": [
        "CREATE VIEW d.v AS SELECT id FROM d.t"
      ]
    },
    {
      "name": "CREATE MATERIALIZED VIEW",
      "group": "materialized_view_option_list",
      "template": "CREATE MATERIALIZED VIEW n OPTIONS ({option}) AS SELECT id, COUNT(*) AS n FROM t GROUP BY id",
      "implementation": "CREATE MATERIALIZED VIEW"
    },
    {
      "name": "ALTER MATERIALIZED VIEW SET OPTIONS",
      "group": "materialized_view_set_options_list",
      "template": "ALTER MATERIALIZED VIEW v SET OPTIONS ({option})",
      "setup": [
        "CREATE MATERIALIZED VIEW d.v AS SELECT id, COUNT(*) AS n FROM d.t GROUP BY id"
      ]
    },
    {
      "name": "CREATE FUNCTION SQL",
      "group": "function_option_list",
      "template": "CREATE FUNCTION d.f(x INT64) RETURNS INT64 AS (x + 1) OPTIONS ({option})",
      "implementation": "CREATE FUNCTION",
      "only": [
        "description"
      ]
    },
    {
      "name": "CREATE FUNCTION JavaScript",
      "group": "function_option_list",
