#!/usr/bin/env bash
# Bazelisk runs this wrapper in place of Bazel. Actions and repository rules inherit PATH (see
# .bazelrc), so a PATH that differs between shells, such as `nix develop -c` run inside a direnv
# shell, would rebuild everything. Use the fixed build-tool PATH from flake.nix,
# followed by the system directories macOS toolchains need.
if [[ -n "${BAZEL_DEVSHELL_PATH:-}" ]]; then
  export PATH="$BAZEL_DEVSHELL_PATH:/usr/bin:/bin:/usr/sbin:/sbin"
  # Nix shell hooks add headers and libraries for development tools. Bazel manages its own
  # dependencies; keep toolchain detection identical to apps without those shell hooks.
  unset NIX_CFLAGS_COMPILE NIX_LDFLAGS NIX_HARDENING_ENABLE
  # Bazel distinguishes an unset library path from an empty one; Nix tools use runtime paths.
  export LD_LIBRARY_PATH=
fi
exec "$BAZEL_REAL" "$@"
