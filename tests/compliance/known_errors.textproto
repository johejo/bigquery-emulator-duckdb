# proto-file: googlesql/compliance/known_error.proto
# proto-message: KnownErrorFile
#
# Compliance tests the emulator is known to fail, on every platform; known_errors_linux.textproto and
# known_errors_macos.textproto list those that fail on one only. A statement that fails is listed by
# its name, under the reason it fails, so that any other statement that fails, or a listed one that
# fails in a worse mode, fails the test. Remove a statement once it passes: `just
# compliance-summary` names those that do.

# The emulator rejects what it does not support as unsupported, which clients can tell apart from
# BigQuery's behavior: any statement may fail as UNIMPLEMENTED. A wrong result, or an error where
# BigQuery succeeds, still fails the test.
known_errors {
  mode: ALLOW_UNIMPLEMENTED
  reason: "The emulator rejects what it does not support"
  label: ".*"
}

# BigQuery generates arrays far longer than GoogleSQL's 16000 elements, so the emulator lifts the
# limit, and these ranges of about 1e38 BIGNUMERIC elements run for most of an hour each before
# they fail, as the tests expect, with or without SAFE. They are not run.
known_errors {
  mode: CRASHES_DO_NOT_RUN
  reason: "GENERATE_ARRAY over a BIGNUMERIC range too long to generate"
  label: "code:(safe_error_mode__safe_)?generate_array_BIGNUMERIC_0_BIGNUMERIC_1_BIGNUMERIC_0.00000000000000000000000000000000000001"
  label: "code:(safe_error_mode__safe_)?generate_array_BIGNUMERIC_-578960446186580977117854925043439539266.34992332820282019728792003956564819968_BIGNUMERIC_578960446186580977117854925043439539266.34992332820282019728792003956564819967_BIGNUMERIC_1"
}

# Statements that fail, by reason.

known_errors {
  mode: ALLOW_ERROR
  reason: "An invalid argument, such as a NULL or negative offset, does not fail as BigQuery does"
  label: "limit_queries_test:param_limit_negative"
  label: "limit_queries_test:param_offset_negative"
}

known_errors {
  mode: ALLOW_ERROR_OR_WRONG_ANSWER
  reason: "An invalid argument, such as a NULL or negative offset, does not fail as BigQuery does"
  label: "analytic_lag_test:lag_negative_offset"
  label: "analytic_lag_test:lag_null_offset"
  label: "analytic_lead_test:lead_negative_offset"
  label: "analytic_lead_test:lead_null_offset"
  label: "analytic_nth_value_test:nth_value_negative_n"
  label: "analytic_nth_value_test:nth_value_null_n"
  label: "analytic_nth_value_test:nth_value_zero_n"
  label: "analytic_ntile_test:ntile_null_bucket_count"
  label: "limit_queries_test:expr_limit_null"
  label: "limit_queries_test:expr_offset_null"
  label: "limit_queries_test:limit_null"
  label: "limit_queries_test:offset_null"
  label: "limit_queries_test:param_limit_null"
  label: "limit_queries_test:param_offset_null"
}

