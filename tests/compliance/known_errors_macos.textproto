# proto-file: googlesql/compliance/known_error.proto
# proto-message: KnownErrorFile
#
# Compliance tests the emulator fails on macOS only, in addition to known_errors.textproto.

known_errors {
  mode: ALLOW_ERROR_OR_WRONG_ANSWER
  reason: "GoogleSQL's reference implementation computes extreme FLOAT64 statistics in long double, whose precision differs by platform, and the emulator's results match it on some platforms only"
  label: "analytic_stat_aggregation_test:analytic_stats_double_column_covar_pop_double_extreme_inf"
  label: "analytic_stat_aggregation_test:analytic_stats_double_column_covar_samp_double_extreme_inf"
  label: "analytic_stat_aggregation_test:analytic_stats_double_column_rows_unbounded_current_row_params"
  label: "analytic_stat_aggregation_test:analytic_stats_double_column_rows_unbounded_current_row_params_2"
  label: "analytic_stat_aggregation_test:analytic_stats_single_column_var_pop_double_extreme_inf"
  label: "stat_aggregation_test:covar_pop_double_extreme_negative_slope"
  label: "stat_aggregation_test:covar_samp_double_extreme_negative_slope"
  label: "stat_aggregation_test:var_pop_double_extreme_inf"
  label: "stat_aggregation_test:var_samp_double_extreme_inf"
}

known_errors {
  mode: ALLOW_ERROR_OR_WRONG_ANSWER
  reason: "GoogleSQL's reference implementation sums FLOAT64 exactly, which the emulator's long double sum holds only where a long double is wider than a double, so a partial sum's overflow fails on macOS"
  label: "analytic_sum_test:analytic_sum_double_overflow_3"
}
