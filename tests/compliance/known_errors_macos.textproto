# proto-file: googlesql/compliance/known_error.proto
# proto-message: KnownErrorFile
#
# Compliance tests the emulator fails on macOS only, in addition to known_errors.textproto.

known_errors {
  mode: ALLOW_ERROR_OR_WRONG_ANSWER
  reason: "GoogleSQL's reference implementation computes extreme FLOAT64 averages and statistics in long double, whose precision differs by platform, and the emulator's results match it on some platforms only"
