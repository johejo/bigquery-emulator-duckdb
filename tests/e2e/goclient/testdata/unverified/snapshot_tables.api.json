                },
                {
                  "name": "name",
                  "type": "STRING"
                }
              ]
            },
            "snapshotDefinition": {
              "baseTableReference": {
                "datasetId": "bqa_qaa6diohlezne7r4fq4qb3qji2_copy_snapshot",
                "projectId": "johejo-sandbox",
                "tableId": "base"
              },
              "snapshotTime": "2026-10-21T07:10:02.221Z"
            },
            "type": "SNAPSHOT"
          },
          "wait": {
            "status": {
              "state": "DONE"
            }
          }
        }
