  "cases": [
    {
      "name": "copy_snapshot",
      "description": "Which table a copy job with operationType SNAPSHOT makes, and which metadata it takes.",
      "steps": [
        {
          "name": "create_dataset",
          "rest": {
            "method": "POST",
            "path": "/bigquery/v2/projects/${project}/datasets",
            "body": {
              "datasetReference": {
                "datasetId": "${dataset}"
              },
              "location": "US"
            }
          }
        },
        {
          "name": "create_snapshot",
          "rest": {
            "method": "POST",
            "path": "/bigquery/v2/projects/${project}/queries",
            "body": {
              "location": "US",
              "query": "CREATE TABLE `${project}.${dataset}.base` (id INT64, name STRING) OPTIONS (description = 'base', friendly_name = 'Base', labels = [('env', 'dev')]); INSERT `${project}.${dataset}.base` (id, name) VALUES (1, 'a'); CREATE SNAPSHOT TABLE `${project}.${dataset}.snap` CLONE `${project}.${dataset}.base`",
              "timeoutMs": 60000,
              "useLegacySql": false
            }
          }
        },
        {
          "name": "copy",
          "rest": {
            "method": "POST",
            "path": "/bigquery/v2/projects/${project}/jobs",
            "body": {
              "configuration": {
                "copy": {
                  "destinationTable": {
                    "datasetId": "${dataset}",
                    "projectId": "${project}",
                    "tableId": "copied"
                  },
                  "operationType": "SNAPSHOT",
                  "sourceTable": {
                    "datasetId": "${dataset}",
                    "projectId": "${project}",
                    "tableId": "base"
                  }
                }
              },
              "jobReference": {
                "location": "US"
              }
            }
          },
          "bind": {
            "job": "/body/jobReference/jobId"
          },
          "observe": {
            "status": "/body/status"
          }
        },
        {
          "name": "wait",
          "rest": {
            "method": "GET",
            "path": "/bigquery/v2/projects/${project}/jobs/${job}?location=US"
          },
          "observe": {
            "status": "/body/status"
          },
          "until": {
            "/body/status/state": "DONE"
          }
        },
        {
          "name": "get_copied",
          "rest": {
            "method": "GET",
            "path": "/bigquery/v2/projects/${project}/datasets/${dataset}/tables/copied"
          },
          "observe": {
            "cloneDefinition": "/body/cloneDefinition",
            "description": "/body/description",
            "expirationTime": "/body/expirationTime",
            "friendlyName": "/body/friendlyName",
            "labels": "/body/labels",
            "numRows": "/body/numRows",
            "schema": "/body/schema",
            "snapshotDefinition": "/body/snapshotDefinition",
            "type": "/body/type"
          }
        }
      ],
      "cleanup": [
        {
          "name": "delete_dataset",
          "rest": {
            "method": "DELETE",
            "path": "/bigquery/v2/projects/${project}/datasets/${dataset}?deleteContents=true"
          }
        }
      ],
      "answer": {
        "project": "johejo-sandbox",
        "run": "qaa6diohlezne7r4fq4qb3qji2",
        "steps": {
          "copy": {
            "status": {
              "state": "RUNNING"
            }
          },
          "get_copied": {
            "description": "base",
            "friendlyName": "Base",
